    <string name="presentazione_permessi_titolo">Enjoy the experience</string>
    <string name="presentazione_permessi_testo">Before you start, three permissions: here is what they are for.</string>
    <string name="permesso_fotocamera">Camera</string>
    <string name="permesso_fotocamera_testo">To send video to the computer. Without it, WebcamLR can\'t work.</string>
    <string name="permesso_microfono">Microphone</string>
    <string name="permesso_microfono_testo">To use the phone as the computer\'s microphone too, if you turn it on.</string>
    <string name="permesso_notifiche">Notifications</string>
    <string name="permesso_notifiche_testo">For the \"Video to computer\" notice with \"Disconnect\": video keeps going even with the screen off.</string>
    <string name="presentazione_permessi_nota">When you tap \"Start\", Android asks for the camera, microphone and notifications: answer \"Allow\" (or \"While using the app\"). You can change them any time in Settings › Apps › WebcamLR › Permissions.</string>
    <string name="presentazione_inizia">Start</string>
    <string name="presentazione_permessi_scena_fotocamera">The phone\'s video reaches the computer.</string>
    <string name="presentazione_permessi_scena_microfono">The phone\'s audio reaches the computer.</string>
    <string name="presentazione_permessi_scena_notifiche">With the ongoing notice, video keeps going even with the screen off.</string>

