    },
    "Il telefono è in pausa (%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone is paused (%@)"
          }
        }
      }
    },
    "Il telefono è molto caldo: la qualità può calare. Toglilo dal sole o dalla custodia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone is very hot: quality may drop. Move it out of the sun or take it out of its case."
          }
        }
      }
    },
    "Il telefono è troppo caldo: il video può fermarsi. Toglilo dal sole o dalla custodia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone is too hot: the video may stop. Move it out of the sun or take it out of its case."
          }
        }
      }
    },
    "Il testo è cambiato: il telefono ha ancora quello di prima." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
