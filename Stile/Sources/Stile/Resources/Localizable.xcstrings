          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo collegamento"
          }
        }
      }
    },
    "Il telefono non trova il computer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone can’t find the computer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono non trova il computer"
          }
        }
      }
    },
    "Il telefono ricorda ogni computer usato. Se un computer con lo stesso nome si presenta diverso, il telefono si ferma per sicurezza. Succede se hai reinstallato WebcamLR sul computer: collegati di nuovo con il QR code. Se non hai cambiato niente, non collegarti." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone remembers every computer it has used. If a computer with the same name shows up different, the phone stops for safety. This happens if you reinstalled WebcamLR on the computer: connect again with the QR code. If you didn’t change anything, don’t connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono ricorda ogni computer usato. Se un computer con lo stesso nome si presenta diverso, il telefono si ferma per sicurezza. Succede se hai reinstallato WebcamLR sul computer: collegati di nuovo con il QR code. Se non hai cambiato niente, non collegarti."
          }
        }
      }
    },
    "Il telefono si scalda" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone gets hot"
