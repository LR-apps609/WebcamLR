            "state" : "translated",
            "value" : "Metti il telefono in orizzontale, all'altezza degli occhi, su un supporto."
          }
        }
      }
    },
    "Microfono del telefono sul Mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phone microphone on the Mac"
          }
        },
        "it" : {
