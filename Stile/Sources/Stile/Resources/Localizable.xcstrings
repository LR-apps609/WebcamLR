          }
        }
      }
    },
    "In hotel o in ufficio, dove la rete blocca i dispositivi tra loro, attiva l'hotspot del telefono e collega il computer a quello." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At a hotel or office, where the network blocks devices from each other, turn on the phone’s hotspot and connect the computer to it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In hotel o in ufficio, dove la rete blocca i dispositivi tra loro, attiva l'hotspot del telefono e collega il computer a quello."
