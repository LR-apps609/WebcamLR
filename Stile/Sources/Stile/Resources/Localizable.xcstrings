          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrizione del problema"
          }
        }
      }
    },
    "Doppio tocco per passare dalla fotocamera posteriore alla frontale." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap to switch between the back and front cameras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppio tocco per passare dalla fotocamera posteriore alla frontale."
          }
        }
      }
    },
    "Durante le chiamate lo schermo si oscura da solo: si risparmia batteria e il telefono scalda meno." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During calls the screen darkens by itself: it saves battery and the phone stays cooler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante le chiamate lo schermo si oscura da solo: si risparmia batteria e il telefono scalda meno."
          }
        }
      }
    },
    "Effetti: sfondo sfocato e luce da studio" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effects: blurred background and studio light"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effetti: sfondo sfocato e luce da studio"
          }
        }
      }
    },
    "Guarda l'indicatore in alto: «Ottimo», «Buono» o «Debole». Con «Debole» avvicinati al router, usa la rete a 5 GHz, ferma i download, oppure usa il cavo USB. Il Wi-Fi diretto, se acceso sul Mac, può rendere la latenza meno stabile: spegnilo se non serve." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at the indicator at the top: “Excellent”, “Good” or “Weak”. With “Weak”, move closer to the router, use the 5 GHz network, stop downloads, or use the USB cable. Wi-Fi Direct, if turned on on the Mac, can make latency less stable: turn it off if you don’t need it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda l'indicatore in alto: «Ottimo», «Buono» o «Debole». Con «Debole» avvicinati al router, usa la rete a 5 GHz, ferma i download, oppure usa il cavo USB. Il Wi-Fi diretto, se acceso sul Mac, può rendere la latenza meno stabile: spegnilo se non serve."
          }
        }
      }
    },
    "Il mio video passa da Internet?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does my video go over the internet?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mio video passa da Internet?"
          }
        }
      }
    },
    "Il primo collegamento" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
