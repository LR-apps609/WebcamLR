    "Nessun video e nessuna immagine vengono inviati: solo il testo qui sopra." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No video and no images are sent: only the text above."
