<Project Sdk="Microsoft.NET.Sdk">

  <!-- Qualità 11: il banco del ritocco della pelle e della luce sul volto (Documenti/Ritocco pelle - banco.md). Volti
       sintetici disegnati qui (nessuna foto di persone), le ricette vere di WebcamLR.Effetti, le misure in testo.
       Come si esegue: in cima a Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Effetti Condition="'$(Effetti)' == ''">..\..\Windows\WebcamLR.Effetti</Effetti>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Effetti)\WebcamLR.Effetti.csproj" />
  </ItemGroup>

</Project>
