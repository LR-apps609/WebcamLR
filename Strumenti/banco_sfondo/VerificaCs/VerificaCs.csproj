<Project Sdk="Microsoft.NET.Sdk">

  <!-- Il banco della qualità dello sfondo (Strumenti/banco_sfondo): passa i fotogrammi nella libreria C# vera
       (RitaglioPersona e Compositore di WebcamLR.Effetti) per controllare che la versione numpy faccia gli stessi conti
       e per misurare i tempi della resa di Windows. Non fa parte dell'app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VerificaCs</RootNamespace>
    <!-- La libreria da provare: quella di questa copia, oppure un'altra (per esempio un altro ramo) con
         dotnet run -p:CartellaEffetti=<cartella di WebcamLR.Effetti>, o l'opzione «effetti» di verifica_cs.py. -->
    <CartellaEffetti Condition="'$(CartellaEffetti)' == ''">$(MSBuildThisFileDirectory)..\..\..\Windows\WebcamLR.Effetti</CartellaEffetti>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CartellaEffetti)\WebcamLR.Effetti.csproj" />
  </ItemGroup>

</Project>
