<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WebcamLR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- I token (colori, pennelli, caratteri, misure): Token.xaml, generato da Strumenti/genera_token.py
                     da Documenti/token.json. Le chiavi di prima (Fondo, Testo, Accento, Ciano, Scheda, Titoli…) restano. -->
                <ResourceDictionary Source="ms-appx:///Token.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- genera_token: inizio (Strumenti/genera_token.py da Documenti/token.json: non modificare a mano) -->
            <!-- Testo scuro sull'accento salvia (pulsanti principali, pulsanti accesi, interruttori), come in Stile:
                 il bianco sull'accento chiaro non si legge. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#13211D" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#22352F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#13211D" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#22352F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Azioni e selezione nell'accento salvia, non nel colore scelto in Windows (di serie blu): pulsanti principali,
                 pulsanti accesi come «Specchia» e «Sfondo», interruttori, selezione negli elenchi.
                 Con il tema scuro WinUI usa le varianti «Light»: Light2 è l'accento di Stile. -->
            <Color x:Key="SystemAccentColor">#9FD0B6</Color>
            <Color x:Key="SystemAccentColorLight1">#AED8C1</Color>
            <Color x:Key="SystemAccentColorLight2">#9FD0B6</Color>
            <Color x:Key="SystemAccentColorLight3">#B9E2CB</Color>
            <Color x:Key="SystemAccentColorDark1">#86BB9F</Color>
            <Color x:Key="SystemAccentColorDark2">#6B9E84</Color>
            <Color x:Key="SystemAccentColorDark3">#517F68</Color>
            <!-- genera_token: fine -->

            <!-- Il carattere dei controlli di WinUI (pulsanti, elenchi, caselle): Barlow al posto di Segoe UI. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Caratteri/Barlow-Regular.ttf#Barlow</FontFamily>

            <!-- I tasti sotto il video (disegno finale): icona sopra e nome sotto, larghi uguali, angoli tondi. Acceso (Specchia,
                 Sfondo) nell'accento con il testo scuro, come gli altri interruttori. -->
            <Style x:Key="TastoBarra" TargetType="Button">
                <Setter Property="Width" Value="80" />
                <Setter Property="Padding" Value="0,9" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="TastoBarraInterruttore" TargetType="ToggleButton">
                <Setter Property="Width" Value="80" />
                <Setter Property="Padding" Value="0,9" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <!-- Le voci dei menu fatti a mano (Account, qualità, strada): tutta la riga cliccabile, testo a sinistra. -->
            <Style x:Key="VoceMenu" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- Ogni testo in Barlow, se non dice altro (titoli e numeri lo dicono). -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Corpo}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
