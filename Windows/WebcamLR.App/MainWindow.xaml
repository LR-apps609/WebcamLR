<?xml version="1.0" encoding="utf-8"?>
<!-- Finestra del ricevitore (bozza grafica, Windows 1). -->
<Window
    x:Class="WebcamLR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WebcamLR">

    <Grid Background="{StaticResource Fondo}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Sezioni -->
        <StackPanel Grid.Column="0" Padding="6,8" Spacing="2">
            <ListView SelectedIndex="0">
                <ListViewItem Content="Anteprima" />
                <ListViewItem Content="Telefoni" />
                <ListViewItem Content="Registrazioni" />
                <ListViewItem Content="Diagnostica" />
            </ListView>
        </StackPanel>

        <!-- Anteprima -->
        <ScrollViewer Grid.Column="1" Background="{StaticResource Pannello}" BorderBrush="{StaticResource Linea}" BorderThickness="1,1,1,0" CornerRadius="8,0,0,0">
            <StackPanel Padding="16" Spacing="12">
                <Grid>
                    <TextBlock Text="Anteprima" FontSize="26" FontWeight="SemiBold" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,4" CornerRadius="13" BorderBrush="{StaticResource Linea}" BorderThickness="1">
                        <TextBlock Text="NESSUN TELEFONO" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TestoSecondario}" />
                    </Border>
                </Grid>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                         Title="Microfono virtuale non installato."
                         Message="Il video funzionerà già; per usare l'audio del telefono servirà un piccolo driver (round 9)." />

                <Border Background="Black" CornerRadius="8">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="1600" Height="900">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                <FontIcon Glyph="&#xE8EA;" FontSize="72" Foreground="{StaticResource TestoSecondario}" />
                                <TextBlock Text="Apri WebcamLR sull'iPhone e scegli questo PC" FontSize="36" Foreground="{StaticResource TestoSecondario}" />
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Border>

                <Border Background="{StaticResource Fondo}" CornerRadius="6" Padding="12,8">
                    <TextBlock Text="Nessun telefono collegato" FontFamily="{StaticResource Numeri}" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Telefono e fotocamera -->
        <StackPanel Grid.Column="2" Padding="16" Spacing="12" Background="{StaticResource Pannello}" BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,0">
            <TextBlock Text="Fotocamera" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="I controlli si attivano quando un telefono è collegato." TextWrapping="Wrap" Foreground="{StaticResource TestoSecondario}" />
            <ComboBox Header="Obiettivo" PlaceholderText="Principale 1×" IsEnabled="False" HorizontalAlignment="Stretch" />
            <ComboBox Header="Risoluzione e fotogrammi" PlaceholderText="1080p · 30 fps" IsEnabled="False" HorizontalAlignment="Stretch" />
            <Slider Header="Esposizione" Minimum="-3" Maximum="3" Value="0" IsEnabled="False" />
            <Slider Header="Bilanciamento del bianco" Minimum="2500" Maximum="7500" Value="5000" IsEnabled="False" />
            <Border Background="{StaticResource Scheda}" CornerRadius="6" Padding="12,10">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TestoSecondario}">
                    <Run Text="In Teams, Zoom o OBS scegli" /> <Run Text="WebcamLR" FontWeight="SemiBold" Foreground="{StaticResource Testo}" /> <Run Text="come videocamera." />
                </TextBlock>
            </Border>
        </StackPanel>
    </Grid>
</Window>
