<?xml version="1.0" encoding="utf-8"?>
<!-- Finestra del ricevitore (bozza grafica, Windows 1). -->
<Window
    x:Class="WebcamLR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WebcamLR">

    <Grid x:Name="Radice" Background="{StaticResource Fondo}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColonnaSinistra" Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ColonnaDestra" Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Sezioni e telefono -->
        <StackPanel x:Name="PannelloSinistro" Grid.Column="0" Padding="6,8" Spacing="16">
            <ListView SelectedIndex="0" AutomationProperties.Name="Sezioni">
                <ListViewItem Content="Anteprima" />
                <!-- Le altre sezioni arrivano con i prossimi round: disattivate, così non sembrano rotte. -->
                <ListViewItem Content="Telefoni" IsEnabled="False" ToolTipService.ToolTip="Più telefoni insieme: in arrivo" />
                <ListViewItem Content="Registrazioni" IsEnabled="False" ToolTipService.ToolTip="Foto e registrazioni su Windows: in arrivo" />
                <ListViewItem Content="Diagnostica" IsEnabled="False" ToolTipService.ToolTip="Diagnostica del collegamento: in arrivo" />
            </ListView>
            <StackPanel Padding="10,0" Spacing="6">
                <TextBlock Text="TELEFONO" FontFamily="{StaticResource Etichette}" FontSize="14" CharacterSpacing="80" Foreground="{StaticResource TestoSecondario}" />
                <Border x:Name="SchedaTelefono" Background="{StaticResource Scheda}" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="NomeTelefono" Text="In attesa di un telefono" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DettagliTelefono" Text="" FontFamily="{StaticResource Numeri}" FontSize="12" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button x:Name="PulsanteApp" Click="SuApp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="10,0"
                    AutomationProperties.Name="App e assistenza: Pro, guida, informazioni, segnala un bug">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                    <TextBlock Text="App e assistenza" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Anteprima -->
        <ScrollViewer x:Name="ScorrimentoAnteprima" Grid.Column="1" Background="{StaticResource Pannello}" BorderBrush="{StaticResource Linea}" BorderThickness="1,1,1,0" CornerRadius="8,0,0,0">
            <StackPanel x:Name="PannelloAnteprima" Padding="16" Spacing="12">
                <Grid x:Name="Intestazione">
                    <TextBlock Text="Anteprima" FontFamily="{StaticResource Titoli}" FontSize="32" />
                    <Border x:Name="PillolaStato" HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" Padding="12,0" CornerRadius="15" BorderBrush="#3C4844" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="PuntoStato" Width="8" Height="8" Stroke="{StaticResource TestoSecondario}" StrokeThickness="1.5" />
                            <TextBlock x:Name="TestoStato" AutomationProperties.LiveSetting="Polite" Text="NESSUN TELEFONO" FontFamily="{StaticResource Etichette}" FontSize="16" CharacterSpacing="60" Foreground="{StaticResource TestoSecondario}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar x:Name="AvvisoMicrofono" IsOpen="True" IsClosable="False" Severity="Warning"
                         Title="Microfono virtuale non installato."
                         Message="Il video funziona già. L'audio dell'iPhone arriverà con un aggiornamento." />

                <!-- Diagnosi (1.3): senza telefono, perché non si collega e cosa fare, con la risposta nelle domande frequenti. -->
                <InfoBar x:Name="BarraDiagnosi" IsOpen="False" IsClosable="False" Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Name="AzioneDiagnosi" Click="SuAzioneDiagnosi" />
                    </InfoBar.ActionButton>
                    <HyperlinkButton x:Name="RispostaDiagnosi" Content="Leggi la risposta nelle domande frequenti" Click="SuRispostaDiagnosi" Margin="0,0,0,8" />
                </InfoBar>

                <!-- Suggerimenti sul cavo USB (1.7): senza il servizio di Apple il cavo non funziona, il Wi-Fi sì. Si possono chiudere. -->
                <InfoBar x:Name="BarraCavo" IsOpen="False" IsClosable="True" Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="AzioneCavo" Click="SuAzioneDiagnosi" />
                    </InfoBar.ActionButton>
                    <HyperlinkButton x:Name="RispostaCavo" Content="Come funziona il cavo USB" Click="SuRispostaDiagnosi" Margin="0,0,0,8" />
                </InfoBar>

                <Grid x:Name="RiquadroVideo" Background="Black" CornerRadius="8" DoubleTapped="SuDoppioToccoVideo">
                    <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <MediaPlayerElement.RenderTransform>
                            <ScaleTransform x:Name="Specchio" ScaleX="1" />
                        </MediaPlayerElement.RenderTransform>
                    </MediaPlayerElement>
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="Segnaposto" Width="1600" Height="900">
                            <StackPanel x:Name="PannelloMessaggio" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE8EA;" AutomationProperties.AccessibilityView="Raw" FontSize="72" Foreground="{StaticResource TestoSecondario}" />
                                <TextBlock x:Name="MessaggioAnteprima" Text="" FontSize="36" Foreground="{StaticResource TestoSecondario}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1200" />
                            </StackPanel>

                            <!-- Primo avvio (round 2): QR code grande e i tre passi per collegarsi. -->
                            <StackPanel x:Name="PrimoAvvio" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="96">
                                <Border x:Name="CorniceQRGrande" Background="White" CornerRadius="16" Padding="24" VerticalAlignment="Center">
                                    <Image x:Name="ImmagineQRGrande" Width="420" Height="420" AutomationProperties.Name="QR code per collegare l'iPhone" />
                                </Border>
                                <StackPanel Spacing="40" VerticalAlignment="Center" Width="820">
                                    <TextBlock Text="Collega l'iPhone" FontFamily="{StaticResource Titoli}" FontSize="72" Foreground="{StaticResource Testo}" />
                                    <Grid ColumnSpacing="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="64" CornerRadius="32" BorderBrush="{StaticResource Ciano}" BorderThickness="3" VerticalAlignment="Top">
                                            <TextBlock Text="1" FontFamily="{StaticResource Etichette}" FontSize="34" Foreground="{StaticResource Ciano}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Collega l'iPhone e questo PC alla stessa rete Wi-Fi." FontSize="36" Foreground="{StaticResource Testo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="64" CornerRadius="32" BorderBrush="{StaticResource Ciano}" BorderThickness="3" VerticalAlignment="Top">
                                            <TextBlock Text="2" FontFamily="{StaticResource Etichette}" FontSize="34" Foreground="{StaticResource Ciano}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Apri WebcamLR sull'iPhone." FontSize="36" Foreground="{StaticResource Testo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnSpacing="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="64" CornerRadius="32" BorderBrush="{StaticResource Ciano}" BorderThickness="3" VerticalAlignment="Top">
                                            <TextBlock Text="3" FontFamily="{StaticResource Etichette}" FontSize="34" Foreground="{StaticResource Ciano}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="TestoTerzoPasso" Grid.Column="1" Text="Scegli questo PC nell'elenco, oppure inquadra il QR code." FontSize="36" Foreground="{StaticResource Testo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="IndirizzoScrittoGrande" Text="" FontFamily="{StaticResource Numeri}" FontSize="26" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                    <!-- Avvisi dal telefono (round 2): molto caldo o batteria bassa, sopra il video. -->
                    <InfoBar x:Name="BarraAvvisoTelefono" VerticalAlignment="Top" Margin="12" IsOpen="False" IsClosable="True" Severity="Warning" />
                    <!-- Nella finestra mini resta solo il video, con questo pulsante per tornare indietro. -->
                    <Button x:Name="PulsanteTornaFinestra" TabIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8" Visibility="Collapsed" Click="SuTornaFinestra"
                            Background="#99121817" AutomationProperties.Name="Torna alla finestra intera" ToolTipService.ToolTip="Torna alla finestra intera (Esc)">
                        <FontIcon Glyph="&#xE73F;" FontSize="14" />
                    </Button>
                </Grid>

                <Grid x:Name="BarraStatistiche" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Fondo}" CornerRadius="6" Padding="12,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <!-- Tipo di collegamento (1.2): Wi-Fi, cavo USB, cavo di rete o hotspot, con un consiglio al passaggio. -->
                                <StackPanel x:Name="ChipCollegamento" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                    <FontIcon x:Name="IconaCollegamento" Glyph="&#xE701;" FontSize="13" Foreground="{StaticResource TestoSecondario}" />
                                    <TextBlock x:Name="TestoCollegamento" FontFamily="{StaticResource Etichette}" FontSize="14" Foreground="{StaticResource Testo}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Qualità in parole (round 2): tre tacche e la parola, i numeri nell'aiuto al passaggio. -->
                                <StackPanel x:Name="ChipQualita" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Name="SuggerimentoQualita" />
                                    </ToolTipService.ToolTip>
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Rectangle x:Name="Tacca1" Width="3" Height="5" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                                        <Rectangle x:Name="Tacca2" Width="3" Height="8" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                                        <Rectangle x:Name="Tacca3" Width="3" Height="11" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <TextBlock x:Name="TestoQualita" FontFamily="{StaticResource Etichette}" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TestoStatistiche" Grid.Column="1" Text="Nessun telefono collegato" FontFamily="{StaticResource Numeri}" FontSize="12" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- Grafico della latenza: gli ultimi 60 secondi, con la linea guida dei 100 ms. -->
                            <Canvas x:Name="GraficoLatenza" Grid.Column="2" Width="118" Height="24" VerticalAlignment="Center" Visibility="Collapsed"
                                    AutomationProperties.Name="Grafico della latenza, ultimi 60 secondi">
                                <Line x:Name="Guida100" X1="0" X2="118" Stroke="{StaticResource Linea}" StrokeThickness="1" StrokeDashArray="2,2" />
                                <Polyline x:Name="LineaLatenza" Stroke="{StaticResource Ciano}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <ToggleButton x:Name="PulsanteSpecchia" Grid.Column="1" TabIndex="2" Content="Specchia" VerticalAlignment="Stretch" Click="SuSpecchia"
                                  ToolTipService.ToolTip="Specchia l'anteprima, solo in questa finestra" />
                    <Button x:Name="PulsanteMini" Grid.Column="2" TabIndex="3" Content="Finestra mini" VerticalAlignment="Stretch" Click="SuFinestraMini"
                            ToolTipService.ToolTip="Il video in una finestrella sempre in primo piano" />
                    <Button x:Name="PulsanteScollega" Grid.Column="3" TabIndex="4" Content="Scollega il telefono" VerticalAlignment="Stretch" Visibility="Collapsed" Click="SuScollega"
                            ToolTipService.ToolTip="Chiude il collegamento: l'iPhone non si ricollega da solo" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Fotocamera, nuovo telefono, webcam e impostazioni: scorre se la finestra è bassa. -->
        <ScrollViewer Grid.Column="2" Background="{StaticResource Pannello}" BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PannelloDestro" Padding="16" Spacing="12">
            <TextBlock Text="Fotocamera" FontFamily="{StaticResource Titoli}" FontSize="24" />
            <TextBlock x:Name="DettagliFotocamera" Text="I comandi della fotocamera compaiono quando un telefono è collegato." TextWrapping="Wrap" Foreground="{StaticResource TestoSecondario}" />

            <!-- Comandi della fotocamera dell'iPhone (round 4) -->
            <StackPanel x:Name="PannelloComandi" Spacing="10" Visibility="Collapsed">
                <DropDownButton x:Name="PulsanteProfili" Content="Profili" HorizontalAlignment="Stretch">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MenuProfili" Placement="Bottom" Opening="SuAperturaProfili" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ComboBox x:Name="SceltaObiettivo" Header="Obiettivo" HorizontalAlignment="Stretch" SelectionChanged="SuObiettivo" />
                <Slider x:Name="CursoreZoom" Header="Zoom" Minimum="1" Maximum="10" StepFrequency="0.1" Value="1" ValueChanged="SuZoom" />
                <Slider x:Name="CursoreEsposizione" Header="Esposizione" Minimum="-2" Maximum="2" StepFrequency="0.1" Value="0" ValueChanged="SuEsposizione" />
                <ToggleSwitch x:Name="EsposizioneManuale" Header="Esposizione manuale (ISO e tempo)" IsOn="False" Visibility="Collapsed" Toggled="SuEsposizioneManuale" />
                <StackPanel x:Name="PannelloManuale" Spacing="8" Visibility="Collapsed">
                    <Slider x:Name="CursoreIso" Header="ISO" Minimum="25" Maximum="3200" StepFrequency="1" Value="400" ValueChanged="SuIso" />
                    <ComboBox x:Name="SceltaTempo" Header="Tempo" SelectedIndex="3" SelectionChanged="SuTempo">
                        <ComboBoxItem Content="1/25 s" Tag="25" />
                        <ComboBoxItem Content="1/30 s" Tag="30" />
                        <ComboBoxItem Content="1/50 s" Tag="50" />
                        <ComboBoxItem Content="1/60 s" Tag="60" />
                        <ComboBoxItem Content="1/100 s" Tag="100" />
                        <ComboBoxItem Content="1/120 s" Tag="120" />
                        <ComboBoxItem Content="1/250 s" Tag="250" />
                        <ComboBoxItem Content="1/500 s" Tag="500" />
                    </ComboBox>
                </StackPanel>
                <ToggleSwitch x:Name="BiancoAutomatico" Header="Bilanciamento del bianco automatico" IsOn="True" Toggled="SuBiancoAutomatico" />
                <Slider x:Name="CursoreBianco" Header="Bianco (kelvin)" Minimum="2500" Maximum="7500" StepFrequency="100" Value="5000" Visibility="Collapsed" ValueChanged="SuBianco" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="PulsanteTorcia" Content="Torcia" Click="SuTorcia" />
                    <Button Content="Messa a fuoco automatica" Click="SuFuoco" />
                </StackPanel>
            </StackPanel>

            <!-- Senza telefono il QR è già grande al centro: qui compare quando c'è un telefono, per aggiungerne un altro. -->
            <Border x:Name="SchedaNuovoTelefono" Background="{StaticResource Scheda}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nuovo telefono?" FontWeight="SemiBold" />
                    <Border Background="White" CornerRadius="6" Padding="8" HorizontalAlignment="Left">
                        <Image x:Name="ImmagineQR" Width="160" Height="160" AutomationProperties.Name="QR code per collegare l'iPhone" />
                    </Border>
                    <TextBlock Text="Sull'iPhone: «Inquadra il QR code del computer»." TextWrapping="Wrap" Foreground="{StaticResource TestoSecondario}" />
                    <TextBlock x:Name="IndirizzoScritto" Text="" FontFamily="{StaticResource Numeri}" FontSize="12" Foreground="{StaticResource TestoSecondario}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Webcam per le altre app (1.24–1.26): «WebcamLR» nell'elenco delle fotocamere di Zoom, Teams, Meet, OBS… -->
            <Border x:Name="SchedaWebcam" Background="{StaticResource Scheda}" CornerRadius="6" Padding="12">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Webcam per le altre app" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="PuntoWebcam" Width="8" Height="8" Fill="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatoWebcamTesto" Text="" AutomationProperties.LiveSetting="Polite" FontFamily="{StaticResource Etichette}" FontSize="14" CharacterSpacing="60" Foreground="{StaticResource TestoSecondario}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DescrizioneWebcam" Text="" TextWrapping="Wrap" Foreground="{StaticResource TestoSecondario}" />
                    <Button x:Name="PulsanteInstallaWebcam" Content="Installa la webcam WebcamLR" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SuInstallaWebcam"
                            ToolTipService.ToolTip="Windows chiede il permesso dell'amministratore, una volta sola" />
                    <StackPanel x:Name="PannelloOpzioniWebcam" Spacing="8" Visibility="Collapsed">
                        <ComboBox x:Name="SceltaInquadraturaWebcam" Header="Video verticale o di altre proporzioni" HorizontalAlignment="Stretch" SelectionChanged="SuInquadraturaWebcam">
                            <ComboBoxItem Content="Tutto, con bande nere" />
                            <ComboBoxItem Content="Riempi, tagliando i bordi" />
                        </ComboBox>
                        <ToggleSwitch x:Name="InterruttoreSpecchiaWebcam" Header="Specchia anche per chi guarda" OnContent="Sì, gli altri ti vedono specchiato" OffContent="No (consigliato)" Toggled="SuSpecchiaWebcam"
                                      ToolTipService.ToolTip="Zoom, Teams e Meet specchiano già la tua anteprima: chi ti guarda ti vede dritto" />
                    </StackPanel>
                    <HyperlinkButton x:Name="PulsanteRimuoviWebcam" Content="Rimuovi la webcam" Padding="0" Visibility="Collapsed" Click="SuRimuoviWebcam"
                                     ToolTipService.ToolTip="La toglie da tutte le app, senza riavviare il PC" />
                    <InfoBar x:Name="BarraWebcam" IsOpen="False" IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button x:Name="AzioneWebcam" Click="SuAzioneWebcam" Visibility="Collapsed" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <!-- Round 2: all'accesso a Windows l'app parte nascosta, con l'icona accanto all'orologio. -->
            <ToggleSwitch x:Name="InterruttoreAvvio" Header="Avvia con Windows" OnContent="Sì, nascosta accanto all'orologio" OffContent="No" Toggled="SuAvvioConWindows" />

            <!-- Modalità avanzata (1.5): spenta di serie. Accesa mostra statistiche, grafico, controlli manuali, profili e registro. -->
            <ToggleSwitch x:Name="InterruttoreAvanzata" Header="Modalità avanzata" OnContent="Tutti i dettagli e i controlli manuali" OffContent="Solo l'essenziale" Toggled="SuModalitaAvanzata" />
            <StackPanel x:Name="PannelloRegistro" Spacing="6" Visibility="Collapsed">
                <Grid>
                    <TextBlock Text="Registro del collegamento" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="PulsanteCopiaRegistro" Content="Copia" HorizontalAlignment="Right" Padding="10,2" Click="SuCopiaRegistro"
                            ToolTipService.ToolTip="Copia il registro, per esempio per «Segnala un bug»" />
                </Grid>
                <ScrollViewer MaxHeight="220" Background="{StaticResource Scheda}" CornerRadius="6" Padding="8,6">
                    <TextBlock x:Name="TestoRegistro" Text="Ancora nessun evento." FontFamily="{StaticResource Numeri}" FontSize="11" Foreground="{StaticResource TestoSecondario}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Registro del collegamento, gli eventi più recenti in cima" />
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
