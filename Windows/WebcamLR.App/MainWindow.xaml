<?xml version="1.0" encoding="utf-8"?>
<!-- Finestra del ricevitore, come il disegno finale approvato (Documenti/Interfaccia finale.md) e la finestra del Mac:
     intestazione con il logo, lo stato, Aiuto e Account; poi tre colonne. A sinistra telefoni, connessione, uscite e in fondo,
     sempre, il QR per collegare un telefono; al centro il video più largo con la qualità e la strada (menu) e la CAM 2,
     sotto i tasti con icona e nome e le app che usano la webcam; a destra profilo, fotocamera, «Effetti», «Regole fini» e
     «Scollega». Questa è la vista «Completo»; nella vista «Essenziale» (MainWindow.Viste.cs) le colonne si chiudono e le
     loro sezioni si aprono dal pannello «Impostazioni», che le prende in prestito. -->
<Window
    x:Class="WebcamLR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WebcamLR"
    Title="WebcamLR">

    <Grid x:Name="Radice" Background="{StaticResource Fondo}" SizeChanged="SuDimensioniRadice">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="RigaIntestazione" Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Intestazione, come nel disegno finale: logo, nome e stato a sinistra; a destra «Aggiornamento disponibile», Aiuto e
             Account (WebcamLR Pro, Impostazioni, Telefoni fidati, Lingua, Aggiornamenti, Informazioni e privacy). Niente
             login per ora. Nella finestra stretta restano le icone. -->
        <Grid x:Name="Intestazione" Background="{StaticResource SfumaturaIntestazione}" BorderBrush="{StaticResource LineaTenue}" BorderThickness="0,0,0,1"
              Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Il logo del 25 ottobre: sfumatura verde scuro e nove quadratini di salvia, il centro corallo (Strumenti/logo.svg). -->
            <Viewbox Width="24" Height="24" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                <Canvas Width="100" Height="100">
                    <Rectangle Width="100" Height="100" RadiusX="22" RadiusY="22" Fill="{StaticResource SfumaturaLogo}" />
                    <Rectangle Canvas.Left="18" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#8FA199" />
                    <Rectangle Canvas.Left="41" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#B2BFB7" />
                    <Rectangle Canvas.Left="64" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#627A71" />
                    <Rectangle Canvas.Left="18" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#ACBAB2" />
                    <Rectangle Canvas.Left="41" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#E67A67" />
                    <Rectangle Canvas.Left="64" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#768D84" />
                    <Rectangle Canvas.Left="18" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#83988F" />
                    <Rectangle Canvas.Left="41" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#96A89F" />
                    <Rectangle Canvas.Left="64" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#50685F" />
                </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1" FontFamily="{StaticResource Titoli}" FontSize="22" VerticalAlignment="Center" AutomationProperties.Name="WebcamLR">
                <Run Text="Webcam" Foreground="{StaticResource Testo}" /><Run Text="LR" Foreground="{StaticResource Accento}" />
            </TextBlock>
            <!-- Lo stato subito dopo il nome, come nel disegno: corallo solo «in onda». -->
            <Border x:Name="PillolaStato" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" MinHeight="28" Padding="12,0" CornerRadius="14" BorderBrush="{StaticResource Bordo}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="PuntoStato" Width="8" Height="8" Stroke="{StaticResource TestoTenue}" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="TestoStato" x:Uid="TestoStato" AutomationProperties.LiveSetting="Polite" FontFamily="{StaticResource Etichette}" FontSize="15"
                               CharacterSpacing="80" Foreground="{StaticResource TestoTenue}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Spazio sul disco quasi finito mentre si registra (P18): avviso in ambra, come sul Mac. -->
                <StackPanel x:Name="AvvisoSpazio" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource Ambra}" />
                    <TextBlock x:Name="TestoAvvisoSpazio" Foreground="{StaticResource AmbraTesto}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Una versione nuova sul sito (versione.json): pillola nell'accento (un'azione), mai in corallo. -->
                <Button x:Name="PulsanteAggiornamento" x:Uid="PulsanteAggiornamento" Click="SuAggiornamento" Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="15" Padding="12,4"
                        Background="{StaticResource AccentoTenue}" BorderBrush="{StaticResource Accento}" Foreground="{StaticResource AccentoChiaro}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                        <TextBlock x:Name="TestoAggiornamento" x:Uid="TestoAggiornamento" FontFamily="{StaticResource Etichette}" FontSize="15" />
                    </StackPanel>
                </Button>
                <!-- «Impostazioni», come sul Mac: prima di Aiuto e Account e con il loro aspetto, in salvia mentre il pannello è
                     aperto. C'è in tutte e due le viste: su Windows non c'è la barra dei menu, e da qui si arriva a Finestra mini
                     e Riempi. Il pannello scorre da destra sopra il video, con le voci a livelli (MainWindow.Viste.cs). -->
                <Button x:Name="PulsanteImpostazioni" x:Uid="PulsanteImpostazioni" Click="SuImpostazioni" VerticalAlignment="Center" Background="Transparent"
                        BorderBrush="{StaticResource Linea}" Foreground="{StaticResource TestoChiaro}" CornerRadius="8" Padding="12,5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock x:Name="TestoImpostazioni" x:Uid="TestoImpostazioni" />
                    </StackPanel>
                </Button>
                <Button x:Name="PulsanteAiuto" x:Uid="PulsanteAiuto" Click="SuAiuto" VerticalAlignment="Center" Background="Transparent" BorderBrush="{StaticResource Linea}"
                        Foreground="{StaticResource TestoChiaro}" CornerRadius="8" Padding="12,5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE897;" FontSize="14" />
                        <TextBlock x:Name="TestoPulsanteAiuto" x:Uid="TestoPulsanteAiuto" />
                    </StackPanel>
                </Button>
                <!-- Account: un menu (MainWindow.Account.cs). Le preferenze di prima stanno nel pannello «Impostazioni» (passo 8). -->
                <Button x:Name="PulsanteAccount" x:Uid="PulsanteAccount" VerticalAlignment="Center" Background="{StaticResource Pannello}" BorderBrush="{StaticResource Linea}"
                        CornerRadius="8" Padding="6,4,10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Accento}">
                            <TextBlock x:Name="InizialeAccount" FontFamily="{StaticResource CorpoForte}" FontSize="12" Foreground="{StaticResource Fondo}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TestoAccount" x:Uid="TestoAccount" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="MenuAccount" Placement="BottomEdgeAlignedRight" Opening="SuAperturaAccount">
                            <StackPanel Width="290" Spacing="6">
                                <Grid ColumnSpacing="10" Padding="4,2,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Accento}" VerticalAlignment="Center">
                                        <TextBlock x:Name="InizialeMenuAccount" FontFamily="{StaticResource CorpoForte}" FontSize="15" Foreground="{StaticResource Fondo}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NomeAccount" FontFamily="{StaticResource CorpoForte}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="PianoAccount" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <!-- WebcamLR Pro: si sblocca sul telefono, qui si spiega come (pagina «WebcamLR Pro»). -->
                                <Border Background="{StaticResource PannelloChiaro}" BorderBrush="{StaticResource Bordo}" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="WebcamLR Pro" FontFamily="{StaticResource CorpoForte}" VerticalAlignment="Center" />
                                            <local:SegnoPro VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="DescrizioneProAccount" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" />
                                        <Button x:Name="PulsanteProAccount" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="SuProAccount">
                                            <TextBlock x:Name="TestoProAccount" FontFamily="{StaticResource CorpoForte}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <!-- Passo 8 (windows.md §3): un solo posto per le impostazioni, il pannello «Impostazioni» (Ctrl+,). -->
                                    <Button x:Name="VoceImpostazioni" Style="{StaticResource VoceMenu}" Click="SuVoceImpostazioni">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="TestoVoceImpostazioni" />
                                            <TextBlock x:Uid="TastoVoceImpostazioni" Grid.Column="1" Foreground="{StaticResource TestoSecondario}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="VoceTelefoniFidati" Style="{StaticResource VoceMenu}" Click="SuTelefoniFidati">
                                        <TextBlock x:Uid="VoceTelefoniFidati" />
                                    </Button>
                                    <Button x:Name="VoceLingua" x:Uid="VoceLingua" Style="{StaticResource VoceMenu}" Click="SuLingua">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="TestoVoceLingua" />
                                            <TextBlock x:Name="ValoreLingua" Grid.Column="1" Foreground="{StaticResource TestoSecondario}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="VoceAggiornamenti" Style="{StaticResource VoceMenu}" Click="SuVoceAggiornamenti">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="TestoVoceAggiornamenti" />
                                            <TextBlock x:Name="ValoreAggiornamenti" Grid.Column="1" Foreground="{StaticResource TestoSecondario}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="VoceInformazioni" Style="{StaticResource VoceMenu}" Click="SuInformazioni">
                                        <TextBlock x:Uid="VoceInformazioni" />
                                    </Button>
                                    <!-- N2: uscire anche dalla finestra, non solo dal menu dell'icona (la X nasconde). -->
                                    <Button x:Name="VoceEsci" Style="{StaticResource VoceMenu}" Click="SuVoceEsci">
                                        <TextBlock x:Uid="VoceEsci" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="Colonne" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColonnaSinistra" Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColonnaDestra" Width="290" />
            </Grid.ColumnDefinitions>

            <!-- ===== Colonna di sinistra: telefoni, connessione (senza telefono), uscite; in fondo, sempre, il QR per collegare
                 un telefono: «Collega il tuo telefono», o «Collega un altro telefono» con un telefono già collegato. ===== -->
            <Grid x:Name="PannelloSinistro" Background="{StaticResource BarraLaterale}" BorderBrush="{StaticResource LineaTenue}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16,16,16,8" Spacing="20">
                        <!-- Telefoni -->
                        <StackPanel x:Name="SezioneTelefoni" Spacing="8">
                            <TextBlock x:Name="EtichettaTelefoni" x:Uid="EtichettaTelefoni" FontFamily="{StaticResource Etichette}" FontSize="13" CharacterSpacing="110" Foreground="{StaticResource TestoSecondario}" />
                            <Border x:Name="SchedaTelefono" Background="{StaticResource PannelloChiaro}" BorderBrush="{StaticResource Bordo}" BorderThickness="1" CornerRadius="12" Padding="11" Visibility="Collapsed">
                                <StackPanel Spacing="3">
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="PuntoTelefono" Width="7" Height="7" Fill="{StaticResource Verde}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NomeTelefono" Grid.Column="1" FontFamily="{StaticResource CorpoForte}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BatteriaTelefono" Grid.Column="2" FontFamily="{StaticResource Numeri}" FontSize="11" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="DettagliTelefono" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CaldoTelefono" FontSize="12" Foreground="{StaticResource Ambra}" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <!-- P21: con due telefoni, una scheda per telefono con «Nella webcam» e «Scollega» (MainWindow.Telefoni.cs). -->
                            <StackPanel x:Name="ElencoSchedeTelefoni" x:Uid="ElencoSchedeTelefoni" Spacing="6" Visibility="Collapsed" />
                            <!-- Nessun telefono: un riquadro tratteggiato e l'aiuto se il telefono non trova il PC. -->
                            <Grid x:Name="PannelloAttesa">
                                <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource Bordo}" StrokeThickness="1" StrokeDashArray="4,3" />
                                <StackPanel Padding="11" Spacing="4">
                                    <TextBlock x:Uid="NessunTelefonoCollegato" FontSize="13" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" />
                                    <HyperlinkButton x:Uid="TelefonoNonTrovaPC" Padding="0" FontSize="12.5" Tag="non-trova" Click="SuRispostaDiagnosi" />
                                </StackPanel>
                            </Grid>
                            <!-- I telefoni fidati che ora non sono collegati: il PC li conosce e li aspetta. -->
                            <TextBlock x:Name="TestoTelefoniNoti" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <StackPanel x:Name="NotaSecondoTelefono" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <local:SegnoPro VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock x:Uid="DueTelefoniInsiemeSblocca" TextWrapping="Wrap" FontSize="12" MaxWidth="170" Foreground="{StaticResource TestoSecondario}" />
                            </StackPanel>
                            <HyperlinkButton x:Name="PulsanteMostraRiquadro" x:Uid="PulsanteMostraRiquadro" Padding="0" Visibility="Collapsed" Click="SuMostraRiquadro" />
                            <!-- 1.5: gli ultimi eventi del collegamento, per capire cosa è successo. -->
                            <Button x:Name="PulsanteRegistro" x:Uid="PulsanteRegistro" Background="Transparent" BorderThickness="0" Padding="0,4" Foreground="{StaticResource TestoSecondario}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="13" />
                                    <TextBlock x:Uid="TitoloRegistro" FontSize="12.5" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="FinestraRegistro" Placement="Right" Opening="SuAperturaRegistro">
                                        <StackPanel x:Name="ContenutoRegistro" Width="380" Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="TitoloRegistro2" FontFamily="{StaticResource CorpoForte}" VerticalAlignment="Center" />
                                                <Button x:Name="PulsanteCopiaRegistro" x:Uid="PulsanteCopiaRegistro" Grid.Column="1" Padding="10,2" Click="SuCopiaRegistro" />
                                            </Grid>
                                            <ScrollViewer MaxHeight="320" Background="{StaticResource Pannello}" CornerRadius="6" Padding="8,6">
                                                <TextBlock x:Name="TestoRegistro" x:Uid="TestoRegistro" FontFamily="{StaticResource Numeri}" FontSize="11" Foreground="{StaticResource TestoSecondario}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- Connessione: senza telefono le strade possibili (Wi-Fi, cavo USB, cavo di rete) e la diagnosi quando nessuno si
                             collega (1.3, 1.7). Con un telefono la strada è sulla sua scheda e nell'etichetta sul video. -->
                        <StackPanel x:Name="SezioneConnessione" Spacing="6">
                            <TextBlock x:Name="EtichettaConnessione" x:Uid="EtichettaConnessione" FontFamily="{StaticResource Etichette}" FontSize="13" CharacterSpacing="110" Foreground="{StaticResource TestoSecondario}" />
                            <Border x:Name="RigaWifi" CornerRadius="8" Padding="8,0" MinHeight="30">
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="IconaWifi" Glyph="&#xE701;" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                                    <TextBlock x:Name="NomeWifi" Grid.Column="1" Text="Wi-Fi" Foreground="{StaticResource TestoTenue}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatoWifi" Grid.Column="2" FontFamily="{StaticResource Etichette}" FontSize="13" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border x:Name="RigaCavo" CornerRadius="8" Padding="8,0" MinHeight="30">
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="IconaCavo" Glyph="&#xE88E;" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                                    <TextBlock x:Name="NomeCavo" x:Uid="NomeCavo" Grid.Column="1" Foreground="{StaticResource TestoTenue}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatoCavoTesto" Grid.Column="2" FontFamily="{StaticResource Etichette}" FontSize="13" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border x:Name="RigaCavoRete" CornerRadius="8" Padding="8,0" MinHeight="30" Background="{StaticResource AccentoTenue}" Visibility="Collapsed">
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE839;" FontSize="12" Foreground="{StaticResource Accento}" />
                                    <TextBlock x:Uid="CavoRete" Grid.Column="1" FontFamily="{StaticResource CorpoEvidente}" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="InUsoCavoDiRete" Grid.Column="2" FontFamily="{StaticResource Etichette}" FontSize="13" Foreground="{StaticResource Verde}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TestoRete" FontSize="11.5" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Diagnosi (1.3): senza telefono, perché non si collega e cosa fare, con la risposta nelle domande frequenti.
                             Suggerimenti sul cavo USB (1.7): senza il servizio di Apple il cavo non funziona, il Wi-Fi sì. Si possono chiudere. -->
                        <InfoBar x:Name="BarraDiagnosi" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,-12,0,0">
                            <InfoBar.ActionButton>
                                <Button x:Name="AzioneDiagnosi" Click="SuAzioneDiagnosi" />
                            </InfoBar.ActionButton>
                            <HyperlinkButton x:Name="RispostaDiagnosi" x:Uid="RispostaDiagnosi" Click="SuRispostaDiagnosi" Margin="0,0,0,8" />
                        </InfoBar>
                        <InfoBar x:Name="BarraCavo" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,-12,0,0">
                            <InfoBar.ActionButton>
                                <Button x:Name="AzioneCavo" Click="SuAzioneDiagnosi" />
                            </InfoBar.ActionButton>
                            <HyperlinkButton x:Name="RispostaCavo" x:Uid="RispostaCavo" Click="SuRispostaDiagnosi" Margin="0,0,0,8" />
                        </InfoBar>

                        <!-- Uscite: la webcam per le altre app (1.24–1.26), il microfono del telefono (W2) e l'uscita NDI (in arrivo). -->
                        <StackPanel x:Name="SezioneUscite" Spacing="6">
                            <TextBlock x:Name="EtichettaUscite" x:Uid="EtichettaUscite" FontFamily="{StaticResource Etichette}" FontSize="13" CharacterSpacing="110" Foreground="{StaticResource TestoSecondario}" />
                            <Grid ColumnSpacing="8" Padding="8,0" MinHeight="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="IconaWebcam" Glyph="&#xE714;" FontSize="11" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="WebcamAltreApp" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StatoWebcamTesto" Grid.Column="2" AutomationProperties.LiveSetting="Polite" FontFamily="{StaticResource Etichette}" FontSize="13"
                                           Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="24,0,0,0" Spacing="8">
                                <TextBlock x:Name="DescrizioneWebcam" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" />
                                <Button x:Name="PulsanteInstallaWebcam" x:Uid="PulsanteInstallaWebcam" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SuInstallaWebcam" />
                                <ComboBox x:Name="SceltaInquadraturaWebcam" x:Uid="SceltaInquadraturaWebcam" HorizontalAlignment="Stretch" SelectionChanged="SuInquadraturaWebcam" Visibility="Collapsed">
                                    <ComboBox.Header>
                                        <TextBlock x:Uid="VideoVerticaleOAltre" TextWrapping="Wrap" FontSize="12.5" />
                                    </ComboBox.Header>
                                    <ComboBoxItem x:Uid="VoceInquadraturaTutto" />
                                    <ComboBoxItem x:Uid="VoceInquadraturaRiempi" />
                                </ComboBox>
                                <HyperlinkButton x:Name="PulsanteRimuoviWebcam" x:Uid="PulsanteRimuoviWebcam" Padding="0" Visibility="Collapsed" Click="SuRimuoviWebcam" Foreground="{StaticResource TestoSecondario}" />
                                <InfoBar x:Name="BarraWebcam" IsOpen="False" IsClosable="True">
                                    <InfoBar.ActionButton>
                                        <Button x:Name="AzioneWebcam" Click="SuAzioneWebcam" Visibility="Collapsed" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </StackPanel>
                            <!-- Microfono del telefono (W2), come sul Mac: interruttore, livello, nota. Su Windows non c'è un microfono virtuale
                                 (servirebbe un driver firmato): l'audio va all'uscita scelta, di solito un cavo audio virtuale (MainWindow.Microfono.cs). -->
                            <StackPanel x:Name="RigaMicrofono" Spacing="6" Margin="0,4,0,0" Opacity="0.6">
                                <Grid ColumnSpacing="8" Padding="8,0" MinHeight="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="IconaMicrofono" Glyph="&#xE720;" FontSize="11" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TestoMicrofono" x:Uid="TestoMicrofono" Grid.Column="1" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="StatoMicrofonoTesto" Grid.Column="2" AutomationProperties.LiveSetting="Polite" FontFamily="{StaticResource Etichette}" FontSize="13"
                                               Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="InterruttoreMicrofono" x:Uid="InterruttoreMicrofono" Grid.Column="3" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" IsEnabled="False"
                                                  Toggled="SuInterruttoreMicrofono" />
                                </Grid>
                                <!-- Il livello si vede sempre (vuoto finché l'audio non arriva): si capisce subito dov'è. -->
                                <Grid x:Name="LivelloMicrofono" x:Uid="LivelloMicrofono" Margin="32,0,8,0" Height="6" ColumnSpacing="2" />
                                <StackPanel Margin="24,0,0,0" Spacing="8">
                                    <TextBlock x:Name="NotaMicrofono" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" Visibility="Collapsed" />
                                    <ComboBox x:Name="SceltaUscitaMicrofono" x:Uid="SceltaUscitaMicrofono" HorizontalAlignment="Stretch" SelectionChanged="SuUscitaAudio" DropDownOpened="SuApriUsciteAudio">
                                        <ComboBox.Header>
                                            <TextBlock x:Uid="MandaAudio" TextWrapping="Wrap" FontSize="12.5" />
                                        </ComboBox.Header>
                                    </ComboBox>
                                    <HyperlinkButton x:Name="GuidaMicrofono" x:Uid="GuidaMicrofono" Padding="0" Foreground="{StaticResource TestoSecondario}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnSpacing="8" Padding="8,0" MinHeight="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="UscitaNDI" Grid.Column="1" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" BorderBrush="{StaticResource Linea}" BorderThickness="1" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="InArrivo2" FontFamily="{StaticResource Etichette}" FontSize="12" CharacterSpacing="60" Foreground="{StaticResource TestoSecondario}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <!-- In fondo, sempre: il QR per collegare un telefono con l'app WebcamLR (iPhone o Android). Sotto, l'indirizzo da
                     scrivere a mano e il QR della pagina per scaricare l'app (non è quello per collegarsi). -->
                <Border x:Name="BloccoQR" Grid.Row="1" Margin="14,6,14,14" Background="{StaticResource Fondo}" BorderBrush="{StaticResource Linea}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock x:Name="TitoloQR" FontFamily="{StaticResource CorpoForte}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Border x:Name="CorniceQR" Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center">
                            <Image x:Name="ImmagineQR" x:Uid="ImmagineQR" Width="150" Height="150" />
                        </Border>
                        <TextBlock x:Uid="InquadraloConApp" FontSize="12" Foreground="{StaticResource TestoSecondario}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="IndirizzoScritto" FontFamily="{StaticResource Numeri}" FontSize="11" Foreground="{StaticResource TestoSecondario}" IsTextSelectionEnabled="True"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <!-- Passo 7 (windows.md 2.14): «Il PC non è collegato a una rete» con la strada per risolverlo, sotto il QR. -->
                        <Button x:Name="PulsanteWiFi" x:Uid="PulsanteApriWiFi" Click="SuApriWiFi" HorizontalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="PulsanteScaricaApp" x:Uid="PulsanteScaricaApp" Padding="4,2" FontSize="12" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource Accento}">
                            <Button.Flyout>
                                <Flyout Placement="Right">
                                    <StackPanel Width="230" Spacing="10">
                                        <Border Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center">
                                            <Image x:Name="ImmagineQRApp" x:Uid="ImmagineQRApp" Width="170" Height="170" />
                                        </Border>
                                        <TextBlock x:Uid="InquadraloFotocameraTelefonoScaricare" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                                        <HyperlinkButton x:Name="CollegamentoDownload" x:Uid="CollegamentoDownload" Padding="0" FontFamily="{StaticResource CorpoEvidente}" FontSize="12" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Centro: il video più largo, i tasti sotto e le app che usano la webcam. ===== -->
            <Grid x:Name="Centro" Grid.Column="1" Padding="16" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Il video prende il suo spazio per primo, a 16:9 (AdattaVideo); la barra e le app sotto usano ciò che resta. -->
                <Grid x:Name="SpazioVideo" SizeChanged="SuDimensioniVideo">
                    <Border x:Name="BordoVideo" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="12" BorderBrush="{StaticResource Linea}" BorderThickness="1" Background="Black">
                        <Grid x:Name="RiquadroVideo" Background="Black" CornerRadius="11" DoubleTapped="SuDoppioToccoVideo" PointerEntered="SuPuntatoreSulVideo" PointerExited="SuPuntatoreFuoriVideo">
                            <!-- Il video com'è arrivato, mai specchiato qui: «Specchia» lo fa il telefono per tutti (1.14). -->
                            <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" />
                            <!-- Con gli effetti accesi sul PC: l'immagine elaborata dal motore (MainWindow.MotoreEffetti.cs), sopra il
                                 video del lettore; è la stessa che va alla webcam, alle foto e alla registrazione. -->
                            <Image x:Name="VideoElaborato" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                            <Viewbox Stretch="Uniform">
                                <Grid x:Name="Segnaposto" Width="1600" Height="900">
                                    <!-- Nessun telefono, con la colonna di sinistra (e il suo QR) a vista: come la schermata che vedono
                                         Zoom e le altre app, con l'invito a collegarsi. -->
                                    <Grid x:Name="PannelloNessuno" Background="{StaticResource SfumaturaLogo}" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="26">
                                            <Viewbox Width="96" Height="96" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                                <Canvas Width="100" Height="100">
                                                    <Rectangle Canvas.Left="18" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#8FA199" />
                                                    <Rectangle Canvas.Left="41" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#B2BFB7" />
                                                    <Rectangle Canvas.Left="64" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#627A71" />
                                                    <Rectangle Canvas.Left="18" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#ACBAB2" />
                                                    <Rectangle Canvas.Left="41" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#E67A67" />
                                                    <Rectangle Canvas.Left="64" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#768D84" />
                                                    <Rectangle Canvas.Left="18" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#83988F" />
                                                    <Rectangle Canvas.Left="41" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#96A89F" />
                                                    <Rectangle Canvas.Left="64" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#50685F" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Uid="WebcamNonCollegata" FontFamily="{StaticResource Titoli}" FontSize="76" Foreground="{StaticResource Testo}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1300" />
                                            <TextBlock x:Uid="ApriOInquadraQR" FontSize="34" Foreground="{StaticResource TestoSecondario}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1300" />
                                        </StackPanel>
                                        <TextBlock x:Uid="QuelloCheVedonoLeApp" FontSize="26" Foreground="{StaticResource TestoSecondario}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,24" />
                                    </Grid>
                                    <StackPanel x:Name="PannelloMessaggio" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                                        <FontIcon Glyph="&#xE8EA;" AutomationProperties.AccessibilityView="Raw" FontSize="72" Foreground="{StaticResource TestoSecondario}" />
                                        <TextBlock x:Name="MessaggioAnteprima" Text="" FontSize="36" Foreground="{StaticResource TestoSecondario}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1200" />
                                    </StackPanel>
                                </Grid>
                            </Viewbox>
                            <!-- Primo avvio (round 2; passo 7, windows.md 2.2): il QR code grande e i tre passi. I testi hanno misure fisse
                                 (mai sotto 14): solo il QR e la sua cornice si adattano al video, nel Viewbox. Nel video stretto i passi
                                 scorrono invece di rimpicciolirsi. -->
                            <Grid x:Name="PrimoAvvio" MaxWidth="1100" Padding="24" ColumnSpacing="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MaxWidth="420" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border x:Name="CorniceQRGrande" Background="White" CornerRadius="16" Padding="24">
                                        <Image x:Name="ImmagineQRGrande" x:Uid="ImmagineQRGrande" Width="420" Height="420" />
                                    </Border>
                                </Viewbox>
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" VerticalAlignment="Center">
                                    <StackPanel Spacing="14" Padding="0,0,8,0">
                                        <TextBlock x:Uid="CollegaTelefono" FontFamily="{StaticResource Titoli}" FontSize="28" Foreground="{StaticResource Testo}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" BorderBrush="{StaticResource Accento}" BorderThickness="2" VerticalAlignment="Top">
                                                <TextBlock Text="1" FontFamily="{StaticResource Etichette}" FontSize="15" Foreground="{StaticResource Accento}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Uid="CollegaTelefonoQuestoPC" Grid.Column="1" FontSize="16" Foreground="{StaticResource Testo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" BorderBrush="{StaticResource Accento}" BorderThickness="2" VerticalAlignment="Top">
                                                <TextBlock Text="2" FontFamily="{StaticResource Etichette}" FontSize="15" Foreground="{StaticResource Accento}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Uid="ApriWebcamLRSulTelefono" Grid.Column="1" FontSize="16" Foreground="{StaticResource Testo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" BorderBrush="{StaticResource Accento}" BorderThickness="2" VerticalAlignment="Top">
                                                <TextBlock Text="3" FontFamily="{StaticResource Etichette}" FontSize="15" Foreground="{StaticResource Accento}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="TestoTerzoPasso" x:Uid="TestoTerzoPasso" Grid.Column="1" FontSize="16" Foreground="{StaticResource Testo}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="IndirizzoScrittoGrande" Text="" FontFamily="{StaticResource Numeri}" FontSize="14" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <!-- Passo 7 (windows.md 2.14): senza rete, la strada per il Wi-Fi anche qui, non solo nella colonna. -->
                                        <Button x:Name="PulsanteWiFiGrande" x:Uid="PulsanteApriWiFi" Click="SuApriWiFi" Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            <!-- La schermata di attesa, uguale a quella che vedono Zoom e le altre app (WebcamLR.Webcam.Logica, come sul Mac):
                                 collegamento interrotto o webcam in pausa. Stili di WebcamLR Pro: nero, immagine personale, ultima immagine
                                 sfocata (qui scurita sopra l'ultimo fotogramma). Calma, mai rossa: si riprende da sé. -->
                            <Grid x:Name="VeloPausa" Background="{StaticResource SfumaturaLogo}" IsHitTestVisible="False" Visibility="Collapsed">
                                <Image x:Name="ImmagineVeloAttesa" Stretch="UniformToFill" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel x:Name="TestiVeloAttesa" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
                                    <Viewbox Width="40" Height="40" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                        <Canvas Width="100" Height="100">
                                            <Rectangle Width="100" Height="100" RadiusX="22" RadiusY="22" Fill="#33FFFFFF" />
                                            <Rectangle Canvas.Left="18" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#8FA199" />
                                            <Rectangle Canvas.Left="41" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#B2BFB7" />
                                            <Rectangle Canvas.Left="64" Canvas.Top="18" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#627A71" />
                                            <Rectangle Canvas.Left="18" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#ACBAB2" />
                                            <Rectangle Canvas.Left="41" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#E67A67" />
                                            <Rectangle Canvas.Left="64" Canvas.Top="41" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#768D84" />
                                            <Rectangle Canvas.Left="18" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#83988F" />
                                            <Rectangle Canvas.Left="41" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#96A89F" />
                                            <Rectangle Canvas.Left="64" Canvas.Top="64" Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="#50685F" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="TitoloVeloAttesa" x:Uid="TitoloVeloAttesa" FontFamily="{StaticResource Titoli}" FontSize="34" Foreground="{StaticResource Testo}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="MotivoPausa" FontSize="16" Foreground="{StaticResource TestoChiaro}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SuggerimentoPausa" FontSize="14" Foreground="{StaticResource TestoSecondario}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <!-- In alto a sinistra, con il video: la qualità (un clic apre il menu della qualità, con i numeri e il grafico)
                                 e la strada del collegamento (un clic apre la scelta Automatico, Wi-Fi, Cavo USB quando ci sono più strade). -->
                            <!-- Vista «Essenziale»: prima delle etichette, la pillola del telefono (il nome, o «Collega il tuo telefono»):
                                 un clic apre il QR di sempre, preso dalla colonna di sinistra (MainWindow.Viste.cs). -->
                            <StackPanel x:Name="PilloleVideo" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                <Button x:Name="PillolaTelefono" Click="SuPillolaTelefono" Background="{StaticResource VeloEtichetta}" BorderBrush="#14FFFFFF" CornerRadius="14" Padding="10,4" MinHeight="28" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse x:Name="PuntoPillolaTelefono" Width="7" Height="7" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE8EA;" FontSize="12" Foreground="{StaticResource TestoChiaro}" />
                                        <TextBlock x:Name="TestoPillolaTelefono" FontFamily="{StaticResource CorpoEvidente}" FontSize="12.5" Foreground="{StaticResource Testo}" MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource TestoChiaro}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="FinestraPillolaTelefono" Placement="BottomEdgeAlignedLeft" Opening="SuAperturaPillolaTelefono" Closed="SuChiusuraPillolaTelefono">
                                            <StackPanel Width="260" Spacing="8">
                                                <Grid x:Name="PostoQR" />
                                                <Button x:Name="PulsanteGestisciTelefoni" x:Uid="PulsanteGestisciTelefoni" Style="{StaticResource VoceMenu}" Click="SuGestisciTelefoni" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <StackPanel x:Name="ChipVideo" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                    <Button x:Name="ChipQualita" x:Uid="ChipQualita" Background="{StaticResource VeloEtichetta}" BorderBrush="#14FFFFFF" CornerRadius="8" Padding="10,4" MinHeight="28">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Rectangle x:Name="Tacca1" Width="3" Height="5" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                                                <Rectangle x:Name="Tacca2" Width="3" Height="8" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                                                <Rectangle x:Name="Tacca3" Width="3" Height="11" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                            <TextBlock x:Name="TestoQualita" FontFamily="{StaticResource CorpoEvidente}" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TestoFormatoVideo" FontSize="12.5" Foreground="{StaticResource Testo}" VerticalAlignment="Center" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource TestoChiaro}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout x:Name="FinestraNumeri" Placement="BottomEdgeAlignedLeft" Opening="SuAperturaQualita">
                                                <StackPanel x:Name="ContenutoQualita" Width="280" Spacing="2">
                                                    <TextBlock x:Uid="TitoloMenuQualita" FontFamily="{StaticResource Etichette}" FontSize="12" CharacterSpacing="100" Foreground="{StaticResource TestoSecondario}" Margin="10,2,10,4" />
                                                    <!-- Le scelte dalle capacità del telefono: 720p 30 gratis, le altre grigie con «PRO» senza WebcamLR Pro. -->
                                                    <StackPanel x:Name="ElencoQualita" x:Uid="ElencoQualita" Spacing="2" />
                                                    <TextBlock x:Name="NotaQualitaPro" FontSize="12" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" Margin="10,6,10,0" Visibility="Collapsed" />
                                                    <TextBlock x:Name="TestoQualitaArriva" FontFamily="{StaticResource Numeri}" FontSize="11.5" Foreground="{StaticResource TestoSecondario}" Margin="10,6,10,0" Visibility="Collapsed" />
                                                    <TextBlock x:Name="NotaScendere" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TestoSecondario}" Margin="10,4,10,0" />
                                                    <Rectangle Height="1" Fill="{StaticResource LineaTenue}" Margin="0,10,0,8" />
                                                    <!-- I numeri di sempre (funzioni 28 e 31) e il grafico della latenza: gli ultimi 60 secondi, con la linea dei 100 ms. -->
                                                    <StackPanel Spacing="8" Padding="10,0,10,4">
                                                        <TextBlock x:Uid="TitoloNumeri" FontFamily="{StaticResource Etichette}" FontSize="12" CharacterSpacing="100" Foreground="{StaticResource TestoSecondario}" />
                                                        <Canvas x:Name="GraficoLatenza" x:Uid="GraficoLatenza" Width="248" Height="28" HorizontalAlignment="Left">
                                                            <Line x:Name="Guida100" X1="0" X2="248" Stroke="{StaticResource Linea}" StrokeThickness="1" StrokeDashArray="2,2" />
                                                            <Polyline x:Name="LineaLatenza" Stroke="{StaticResource Accento}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                        </Canvas>
                                                        <TextBlock x:Name="TestoNumeri" FontFamily="{StaticResource Numeri}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <TextBlock x:Uid="OttimoSotto80Ms" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!-- Tipo di collegamento (1.2): Wi-Fi, cavo USB, cavo di rete o hotspot, con un consiglio al passaggio. -->
                                    <Button x:Name="ChipCollegamento" Background="{StaticResource VeloEtichetta}" BorderBrush="#14FFFFFF" CornerRadius="8" Padding="10,4" MinHeight="28" Click="SuChipCollegamento">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon x:Name="IconaCollegamento" Glyph="&#xE701;" FontSize="12" Foreground="{StaticResource TestoChiaro}" />
                                            <TextBlock x:Name="TestoCollegamento" FontSize="12.5" Foreground="{StaticResource Testo}" VerticalAlignment="Center" />
                                            <FontIcon x:Name="FrecciaCollegamento" Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource TestoChiaro}" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout x:Name="FinestraCollegamento" Placement="BottomEdgeAlignedLeft" Opening="SuAperturaCollegamento">
                                                <StackPanel x:Name="ContenutoCollegamento" Width="300" Spacing="2">
                                                    <TextBlock x:Name="TitoloMenuCollegamento" FontFamily="{StaticResource Etichette}" FontSize="12" CharacterSpacing="100" Foreground="{StaticResource TestoSecondario}"
                                                               Margin="10,2,10,4" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel x:Name="ElencoCollegamento" x:Uid="ElencoCollegamento" Spacing="2" />
                                                    <TextBlock x:Uid="NotaAutomatico" FontSize="12" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" Margin="10,8,10,4" />
                                                </StackPanel>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <!-- Sotto le etichette: riconnessione e avvisi dal telefono (caldo, batteria), in ambra. -->
                            <StackPanel x:Name="AvvisiSulVideo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,52,12,12" Spacing="8" MaxWidth="520">
                                <Border x:Name="PillolaRiconnessione" Background="{StaticResource AmbraTenue}" CornerRadius="15" Padding="12,0" MinHeight="30" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Ambra}" VerticalAlignment="Center" />
                                        <TextBlock x:Uid="TestoRiconnessione" FontFamily="{StaticResource Etichette}" FontSize="16" CharacterSpacing="90" Foreground="{StaticResource AmbraTesto}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Passo 5: il telefono non è tornato. Resta finché non lo chiudi o il telefono torna (come sul Mac). -->
                                <InfoBar x:Name="BarraTelefonoPerso" IsOpen="False" IsClosable="True" Severity="Warning">
                                    <HyperlinkButton x:Name="RispostaTelefonoPerso" x:Uid="RispostaTelefonoPerso" Tag="non-trova" Click="SuRispostaDiagnosi" Margin="0,0,0,8" />
                                </InfoBar>
                                <!-- Caldo e batteria: restano finché la causa c'è (windows.md 2.1), senza la X. -->
                                <InfoBar x:Name="BarraAvvisoTelefono" IsOpen="False" IsClosable="False" Severity="Warning" />
                                <!-- Errori (foto, registrazione, immagini) e codice scaduto: restano finché non li chiudi (windows.md 2.1, 2.16). -->
                                <InfoBar x:Name="BarraErrore" IsOpen="False" IsClosable="True" Severity="Error" />
                                <!-- Passo 7 (windows.md 2.5): il video arriva in HEVC e il PC non sa mostrarlo. Microsoft Store per l'estensione,
                                     oppure lo stesso video in H.264 (Protocollo.md: dal computer «formato» chiede anche il codec). -->
                                <InfoBar x:Name="BarraHevc" x:Uid="BarraHevc" IsOpen="False" IsClosable="False" Severity="Warning">
                                    <InfoBar.ActionButton>
                                        <Button x:Name="AzioneHevcStore" x:Uid="AzioneHevcStore" Click="SuApriStoreHevc" />
                                    </InfoBar.ActionButton>
                                    <Button x:Name="AzioneH264" x:Uid="AzioneH264" Click="SuRicollegaH264" Margin="0,0,0,8" />
                                </InfoBar>
                                <!-- P21: un terzo telefono, o un secondo senza Pro, non entra; si dice cosa fare. -->
                                <InfoBar x:Name="BarraTelefoni" IsOpen="False" IsClosable="True" Severity="Informational" />
                                <!-- Foto e registrazioni salvate (windows.md 2.7): dove sono, con «Mostra nella cartella» invece di aprire Esplora file. -->
                                <InfoBar x:Name="BarraRiprese" IsOpen="False" IsClosable="True" Severity="Informational">
                                    <InfoBar.ActionButton>
                                        <Button x:Name="AzioneRiprese" Click="SuMostraNellaCartella" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </StackPanel>
                            <!-- In basso a sinistra: quale telefono è nella webcam, in corallo quando è in onda. -->
                            <Border x:Name="EtichettaCam" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,5" CornerRadius="8" Background="{StaticResource VeloEtichetta}"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="TestoCam" FontSize="12.5" Foreground="{StaticResource Testo}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <!-- P21: la CAM 2 compare solo quando si collega un secondo telefono, in basso a destra dentro il video; «Usa
                                 prospettiva» (o un clic sul riquadro) la mette nella webcam. -->
                            <Grid x:Name="RiquadroPiccolo" x:Uid="RiquadroPiccolo" Width="230" Height="130" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                                  Background="Black" CornerRadius="10" BorderBrush="{StaticResource Fondo}" BorderThickness="2" Visibility="Collapsed"
                                  Tapped="SuRiquadroPiccolo">
                                <MediaPlayerElement x:Name="VideoPiccolo" AreTransportControlsEnabled="False" Stretch="Uniform" IsHitTestVisible="False" />
                                <TextBlock x:Name="StatoPiccolo" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" FontSize="13" IsHitTestVisible="False"
                                           Foreground="{StaticResource TestoSecondario}" TextAlignment="Center" TextWrapping="Wrap" />
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Padding="8,3" CornerRadius="6" Background="{StaticResource VeloEtichetta}" IsHitTestVisible="False">
                                    <TextBlock x:Name="NomePiccolo" FontSize="12" MaxWidth="150" Foreground="{StaticResource Testo}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button x:Name="PulsanteChiudiRiquadro" x:Uid="PulsanteChiudiRiquadro" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="5" Background="#8C000000" Click="SuChiudiRiquadro">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                                <Button x:Name="PulsanteUsaProspettiva" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7"
                                        Padding="10,5" CornerRadius="8" Click="SuUsaProspettiva">
                                    <TextBlock x:Uid="UsaProspettiva" FontFamily="{StaticResource CorpoForte}" FontSize="12.5" />
                                </Button>
                            </Grid>
                            <!-- Foto (P18): lampo bianco, conto alla rovescia del timer e una frase breve in fondo, come sul Mac. -->
                            <Border x:Name="LampoFoto" Background="White" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="ContoAllaRovescia" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,0,40,8" CornerRadius="16"
                                    Background="#9913211D" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
                                <TextBlock x:Name="TestoContoAllaRovescia" FontFamily="{StaticResource Titoli}" FontSize="120" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="AvvisoRiprese" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,48" Padding="12,6" CornerRadius="14"
                                    Background="#EB22352F" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="TestoAvvisoRiprese" Foreground="{StaticResource Testo}" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            </Border>
                            <!-- Nella finestra mini e nella vista pulita resta solo il video, con questo pulsante per tornare indietro. -->
                            <Button x:Name="PulsanteTornaFinestra" x:Uid="PulsanteTornaFinestra" TabIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8" Visibility="Collapsed" Click="SuTornaFinestra"
                                    Background="#EB22352F">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73F;" FontSize="14" />
                                    <TextBlock x:Name="TestoTornaFinestra" x:Uid="TestoTornaFinestra" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- I tasti sotto il video, come nel disegno finale: icona e nome. Specchia e Sfondo (accesi nell'accento), Foto (con
                     accanto il menu del timer e della copia), Registra | Schermo. Senza telefono grigi; la copertura dice cosa fare.
                     Le coperture (CoperturaSpenta) si raggiungono con Tab al posto del tasto spento e spiegano anche con Invio o
                     Spazio; l'Assistente vocale legge «Specchia, non disponibile: …» (windows.md 2.13). -->
                <Border x:Name="BarraAzioni" Grid.Row="1" HorizontalAlignment="Center" Background="{StaticResource Fondo}" BorderBrush="{StaticResource Linea}" BorderThickness="1"
                        CornerRadius="22" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- «Specchia» e «Sfondo» (1.14): valgono per il video inviato, quello che vedono anche le app e il telefono.
                             Il pulsante segue lo «stato» del telefono. Senza telefono grigi; senza la capacità non ci sono. -->
                        <Grid x:Name="ContenitoreSpecchia">
                            <ToggleButton x:Name="PulsanteSpecchia" x:Uid="PulsanteSpecchia" TabIndex="2" Style="{StaticResource TastoBarraInterruttore}" Click="SuSpecchia">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="20" />
                                    <TextBlock x:Name="TestoSpecchia" x:Uid="TestoSpecchia" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ToggleButton>
                            <local:CoperturaSpenta x:Name="CoperturaSpecchia" TabIndex="2" Tapped="SuComandoSenzaTelefono" />
                        </Grid>
                        <!-- «Sfondo»: un clic riaccende l'ultima scelta (sfocatura o sfondo) o spegne. -->
                        <Grid x:Name="ContenitoreSfondoVideo">
                            <ToggleButton x:Name="PulsanteSfondoVideo" x:Uid="PulsanteSfondoVideo" TabIndex="3" Style="{StaticResource TastoBarraInterruttore}" Click="SuSfondoVideo">
                                <StackPanel Spacing="4">
                                    <FontIcon Glyph="&#xE91B;" FontSize="20" />
                                    <TextBlock x:Name="TestoSfondoVideo" x:Uid="TestoSfondoVideo" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ToggleButton>
                            <!-- Nessuno · Sfocatura · Sfondi ▸: dalla freccina nell'angolo (verso l'alto) o con il clic destro (menu fatti nel codice). -->
                            <Button x:Name="PulsanteMenuSfondo" x:Uid="PulsanteMenuSfondo" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="22"
                                    Padding="0" Margin="0,2,2,0" CornerRadius="11" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE70E;" FontSize="9" />
                            </Button>
                            <local:CoperturaSpenta x:Name="CoperturaSfondoVideo" TabIndex="3" Tapped="SuComandoSenzaTelefono" />
                        </Grid>
                        <!-- Foto, con il menu per il timer e la copia nell'angolo (P18). Sono di WebcamLR Pro. -->
                        <Grid x:Name="ContenitoreRiprese">
                            <local:ZonaPro x:Name="ZonaFoto">
                                <Grid x:Name="PannelloRiprese">
                                    <Button x:Name="PulsanteFoto" x:Uid="PulsanteFoto" TabIndex="4" Style="{StaticResource TastoBarra}" Click="SuFoto">
                                        <StackPanel Spacing="4">
                                            <FontIcon x:Name="IconaFoto" Glyph="&#xE722;" FontSize="20" />
                                            <TextBlock x:Name="TestoPulsanteFoto" x:Uid="TestoPulsanteFoto" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PulsanteAltreFoto" x:Uid="PulsanteAltreFoto" TabIndex="5" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="22"
                                            Padding="0" Margin="0,2,2,0" CornerRadius="11" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Top">
                                                <MenuFlyoutItem x:Name="VoceTimer" x:Uid="VoceTimer" Click="SuTimerFoto" />
                                                <MenuFlyoutItem x:Uid="CopiaFotogrammaCtrlC" Click="SuCopiaFotogramma" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </local:ZonaPro>
                            <local:CoperturaSpenta x:Name="CoperturaRiprese" TabIndex="4" Tapped="SuComandoSenzaTelefono" />
                        </Grid>
                        <!-- Registra (P18): il punto corallo solo mentre registra, come «in onda». «Ferma» resta sempre attivo. -->
                        <Grid x:Name="ContenitoreRegistra">
                            <local:ZonaPro x:Name="ZonaRegistra">
                                <Button x:Name="PulsanteRegistra" x:Uid="PulsanteRegistra" TabIndex="6" Style="{StaticResource TastoBarra}" Click="SuRegistra">
                                    <StackPanel Spacing="4">
                                        <Grid Height="20" HorizontalAlignment="Center">
                                            <FontIcon x:Name="IconaRegistra" Glyph="&#xE7C8;" FontSize="20" />
                                            <Ellipse x:Name="PuntoRegistra" Width="12" Height="12" Fill="{StaticResource Tally}" VerticalAlignment="Center" Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="TestoRegistra" x:Uid="TestoRegistra" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </local:ZonaPro>
                            <local:CoperturaSpenta x:Name="CoperturaRegistra" TabIndex="6" Tapped="SuComandoSenzaTelefono" />
                        </Grid>
                        <Rectangle Width="1" Fill="{StaticResource Linea}" Margin="4,6" />
                        <!-- «Schermo»: tre pulsanti come quelli della barra in un menu che si apre sopra, uno per vista: Schermo intero,
                             Essenziale e Completo (MainWindow.Viste.cs); quella di adesso è accesa. Le scorciatoie (F11, Ctrl+1, Ctrl+2)
                             sono scritte nei suggerimenti (passo 8). Finestra mini e «Riempi l'inquadratura» stanno in Impostazioni › Schermo
                             (il pulsante in alto, prima di Aiuto). -->
                        <Button x:Name="PulsanteSchermo" x:Uid="PulsanteSchermo" TabIndex="7" Style="{StaticResource TastoBarra}">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE740;" FontSize="20" />
                                <TextBlock x:Name="TestoSchermo" x:Uid="TestoSchermo" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="MenuSchermo" Placement="Top" Opening="SuAperturaMenuSchermo">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ToggleButton x:Name="PulsanteSchermoIntero" x:Uid="PulsanteSchermoIntero" Style="{StaticResource TastoBarraInterruttore}" Width="112" Click="SuSchermoIntero">
                                            <StackPanel Spacing="4">
                                                <FontIcon x:Name="IconaSchermoIntero" Glyph="&#xE740;" FontSize="20" />
                                                <TextBlock x:Name="TestoSchermoIntero" x:Uid="TestoSchermoIntero" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="PulsanteVistaEssenziale" x:Uid="PulsanteVistaEssenziale" Style="{StaticResource TastoBarraInterruttore}" Width="112" Click="SuVistaEssenziale">
                                            <StackPanel Spacing="4">
                                                <FontIcon Glyph="&#xE714;" FontSize="20" />
                                                <TextBlock x:Uid="TestoVistaEssenziale" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="PulsanteVistaCompleto" x:Uid="PulsanteVistaCompleto" Style="{StaticResource TastoBarraInterruttore}" Width="112" Click="SuVistaCompleto">
                                            <StackPanel Spacing="4">
                                                <FontIcon Glyph="&#xE8A9;" FontSize="20" />
                                                <TextBlock x:Uid="TestoVistaCompleto" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- In fondo, nelle viste «Completo» ed «Essenziale», una riga sola e discreta (come sul Mac): «Disponibile per
                     Zoom · Slack · OBS · Meet e tanti altri», o in corallo «In uso da Zoom» mentre un'app usa la webcam (dalle
                     impostazioni della privacy). Il suggerimento dice cosa serve; nella pagina «Uscite» lo stesso aiuto è scritto
                     sotto (MainWindow.AppInUso.cs). -->
                <Grid x:Name="RigaSotto" Grid.Row="2">
                    <StackPanel x:Name="PannelloAppInUso" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="RigaApp" Background="Transparent">
                            <StackPanel x:Name="RigaAppDisponibili" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" />
                            <StackPanel x:Name="RigaAppInUso" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Tally}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TestoAppInUso" FontSize="12.5" Foreground="{StaticResource TallyTesto}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="AiutoAppWebcam" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== Colonna di destra: profilo, fotocamera e le sezioni richiudibili. ===== -->
            <Grid x:Name="PannelloDestroScorrimento" Grid.Column="2" Background="{StaticResource BarraLaterale}" BorderBrush="{StaticResource LineaTenue}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PannelloDestro" Padding="16" Spacing="16">
                        <!-- P21: con due telefoni i comandi valgono per quello nella webcam. -->
                        <StackPanel x:Name="TelefonoDeiComandi" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="{StaticResource CianoChiaro}" />
                            <TextBlock x:Name="NomeTelefonoDeiComandi" FontFamily="{StaticResource CorpoEvidente}" FontSize="12.5" Foreground="{StaticResource CianoChiaro}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Profilo: quattro profili pronti (WebcamLR Pro) e sotto i profili salvati. -->
                        <Grid x:Name="ContenitoreProfilo">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NomeSezioneProfilo" x:Uid="TitoloProfilo" FontFamily="{StaticResource Titoli}" FontSize="22" VerticalAlignment="Center" />
                                    <!-- Passo 4 (windows.md 2.11): «Personalizzato» si clicca, con «Torna a «Riunione»». Stesso aspetto di prima. -->
                                    <Button x:Name="SegnoPersonalizzato" x:Uid="SegnoPersonalizzato" Grid.Column="1" Background="{StaticResource AccentoTenue}" BorderThickness="0" CornerRadius="10" Padding="8,2" MinHeight="0" MinWidth="0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE9E9;" FontSize="11" Foreground="{StaticResource AccentoChiaro}" />
                                            <TextBlock x:Uid="TestoPersonalizzato" FontFamily="{StaticResource Etichette}" FontSize="14" Foreground="{StaticResource AccentoChiaro}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="MenuPersonalizzato" Placement="Bottom" Opening="SuAperturaPersonalizzato" />
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <local:ZonaPro x:Name="ZonaProfili" Segno="False">
                                    <Grid x:Name="GrigliaProfili" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </local:ZonaPro>
                                <local:RigaPro x:Name="RigaProProfili" Visibility="Collapsed" />
                                <DropDownButton x:Name="PulsanteProfili" x:Uid="PulsanteProfili" Background="Transparent" BorderThickness="0" Padding="0,4" Foreground="{StaticResource TestoTenue}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7B8;" FontSize="13" />
                                        <TextBlock x:Uid="ProfiliSalvati" FontSize="13" />
                                    </StackPanel>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="MenuProfili" Placement="Bottom" Opening="SuAperturaProfili" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                            <local:CoperturaSpenta x:Name="CoperturaProfilo" Tapped="SuComandoSenzaTelefono" />
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource LineaTenue}" />

                        <!-- Fotocamera: pochi comandi a vista. Senza telefono grigi; la copertura dice «Collega un telefono per usarlo.» -->
                        <StackPanel x:Name="SezioneFotocamera" Spacing="12">
                            <TextBlock x:Name="TitoloFotocamera" x:Uid="TitoloFotocamera" FontFamily="{StaticResource Titoli}" FontSize="20" />
                            <TextBlock x:Name="DettagliFotocamera" x:Uid="DettagliFotocamera" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" />
                            <Grid>
                                <StackPanel x:Name="PannelloComandi" Spacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Uid="EtichettaObiettivo" FontFamily="{StaticResource Etichette}" FontSize="14" CharacterSpacing="110" Foreground="{StaticResource TestoSecondario}" />
                                        <!-- Come i segmenti del Mac: un pulsante per obiettivo, quello scelto nell'accento (MostraObiettivi). -->
                                        <Grid x:Name="SceltaObiettivo" x:Uid="SceltaObiettivo" ColumnSpacing="4" />
                                    </StackPanel>
                                    <StackPanel x:Name="PannelloZoom" Spacing="2">
                                        <Grid>
                                            <TextBlock Text="Zoom" />
                                            <TextBlock x:Name="ValoreZoom" Text="1,0×" HorizontalAlignment="Right" FontFamily="{StaticResource Numeri}" FontSize="12.5" Foreground="{StaticResource TestoTenue}" />
                                        </Grid>
                                        <Slider x:Name="CursoreZoom" x:Uid="CursoreZoom" Minimum="1" Maximum="10" StepFrequency="0.1" Value="1" ValueChanged="SuZoom" AutomationProperties.Name="Zoom" />
                                    </StackPanel>
                                    <StackPanel x:Name="PannelloEsposizione" Spacing="2">
                                        <Grid>
                                            <TextBlock x:Uid="EtichettaEsposizione" />
                                            <TextBlock x:Name="ValoreEsposizione" Text="+0,0" HorizontalAlignment="Right" FontFamily="{StaticResource Numeri}" FontSize="12.5" Foreground="{StaticResource TestoTenue}" />
                                        </Grid>
                                        <Slider x:Name="CursoreEsposizione" x:Uid="CursoreEsposizione" Minimum="-2" Maximum="2" StepFrequency="0.1" Value="0" ValueChanged="SuEsposizione" />
                                    </StackPanel>
                                    <TextBlock x:Name="NotaEsposizioneManuale" x:Uid="NotaEsposizioneManuale" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TestoSecondario}" Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ToggleButton x:Name="PulsanteTorcia" x:Uid="PulsanteTorcia" Click="SuTorcia" />
                                        <Button x:Name="PulsanteFuoco" x:Uid="PulsanteFuoco" Click="SuFuoco" />
                                    </StackPanel>
                                </StackPanel>
                                <local:CoperturaSpenta x:Name="CoperturaComandi" Tapped="SuComandoSenzaTelefono" />
                            </Grid>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource LineaTenue}" />

                        <!-- Le sezioni richiudibili, chiuse di serie e ricordate (Preferenze): «Effetti», «Regole fini», «Qualità video». -->
                        <StackPanel Spacing="0">
                            <!-- Effetti del telefono (P04, P06, P08, P09, P11, P13–P15, P17): li fa il telefono, il PC li comanda e mostra lo stato. -->
                            <StackPanel x:Name="SezioneEffetti">
                                <Button x:Name="IntestazioneEffetti" Click="SuSezione" Tag="effetti" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="34">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="FrecciaEffetti" Glyph="&#xE76C;" FontSize="10" Foreground="{StaticResource TestoSecondario}" Width="12" />
                                        <TextBlock x:Name="NomeSezioneEffetti" x:Uid="TitoloEffetti" FontFamily="{StaticResource Titoli}" FontSize="18" />
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="ContenutoEffetti" Spacing="12" Padding="0,6,0,14" Visibility="Collapsed">
                                    <TextBlock x:Name="DettagliEffetti" x:Uid="DettagliEffetti" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TestoSecondario}" />
                                    <local:RigaPro x:Name="RigaProEffetti" Visibility="Collapsed" />
                                    <Grid>
                                        <StackPanel x:Name="PannelloEffetti" Spacing="10">
                                            <local:ZonaPro x:Name="ZonaInquadratura">
                                                <ToggleSwitch x:Name="InterruttoreInquadratura" x:Uid="InterruttoreInquadratura" Toggled="SuInquadraturaAutomatica">
                                                    <ToggleSwitch.Header>
                                                        <TextBlock x:Uid="InquadraturaAutomatica" TextWrapping="Wrap" />
                                                    </ToggleSwitch.Header>
                                                </ToggleSwitch>
                                            </local:ZonaPro>
                                            <ToggleSwitch x:Name="InterruttoreLuceVolto" x:Uid="InterruttoreLuceVolto" Toggled="SuLuceVolto">
                                                <ToggleSwitch.Header>
                                                    <TextBlock x:Name="TestoLuceVolto" x:Uid="LuceSulVolto" TextWrapping="Wrap" />
                                                </ToggleSwitch.Header>
                                            </ToggleSwitch>
                                            <!-- Con la luce del telefono (Effetti video di Apple, «Luce da studio») l'interruttore è acceso e grigio: si regola lì. -->
                                            <TextBlock x:Name="NotaLuceTelefono" x:Uid="NotaLuceTelefono" FontSize="12" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap"
                                                       Margin="0,-6,0,0" Visibility="Collapsed" />
                                            <!-- «Calore» (gratis): un viso un po' più caldo; 0 = i colori della fotocamera, «Neutro» lo riporta lì. -->
                                            <Grid x:Name="PannelloCalore">
                                                <Slider x:Name="CursoreCalore" x:Uid="CursoreCalore" Minimum="0" Maximum="100" StepFrequency="1" Value="0" ValueChanged="SuCalore" />
                                                <HyperlinkButton x:Name="PulsanteCaloreNeutro" x:Uid="PulsanteCaloreNeutro" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SuCaloreNeutro" />
                                            </Grid>
                                            <local:ZonaPro x:Name="ZonaFiltro">
                                                <ComboBox x:Name="SceltaFiltro" x:Uid="SceltaFiltro" HorizontalAlignment="Stretch" SelectionChanged="SuFiltro" />
                                            </local:ZonaPro>
                                            <StackPanel x:Name="PannelloSfondo" Spacing="4">
                                                <ComboBox x:Name="SceltaSfondo" x:Uid="SceltaSfondo" HorizontalAlignment="Stretch" SelectionChanged="SuSfondo">
                                                    <ComboBoxItem x:Uid="VoceSfondoNessuno" Tag="nessuno" />
                                                    <ComboBoxItem x:Uid="VoceSfondoSfocato" Tag="sfocato" />
                                                    <ComboBoxItem x:Name="VoceSfondoSostituito" x:Uid="VoceSfondoSostituito" Tag="sostituito" />
                                                </ComboBox>
                                                <StackPanel x:Name="NotaSfondoPro" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                                    <local:SegnoPro VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <TextBlock x:Uid="SostituitoWebcamLRProSi" TextWrapping="Wrap" FontSize="12" MaxWidth="230" Foreground="{StaticResource TestoSecondario}" />
                                                </StackPanel>
                                                <Slider x:Name="CursoreIntensitaSfondo" x:Uid="CursoreIntensitaSfondo" Minimum="0" Maximum="100" StepFrequency="1" Value="50" ValueChanged="SuIntensitaSfondo" />
                                                <TextBlock x:Name="NotaSfondo" x:Uid="NotaSfondo" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TestoSecondario}" Visibility="Collapsed" />
                                            </StackPanel>
                                            <local:ZonaPro x:Name="ZonaPelle">
                                                <Slider x:Name="CursorePelle" x:Uid="CursorePelle" Minimum="0" Maximum="100" StepFrequency="1" Value="0" ValueChanged="SuPelle" />
                                            </local:ZonaPro>
                                            <!-- Scritta (sottopancia): nome e ruolo, poi «Mostra». Nome vuoto = nessuna scritta. -->
                                            <local:ZonaPro x:Name="ZonaScritta">
                                                <StackPanel x:Name="PannelloScritta" Spacing="6">
                                                    <TextBlock x:Uid="TitoloScritta" FontFamily="{StaticResource CorpoForte}" />
                                                    <TextBox x:Name="CasellaNomeScritta" x:Uid="CasellaNomeScritta" MaxLength="60" TextChanged="SuTestoScritta" />
                                                    <TextBox x:Name="CasellaRuoloScritta" x:Uid="CasellaRuoloScritta" MaxLength="80" TextChanged="SuTestoScritta" />
                                                    <ToggleSwitch x:Name="InterruttoreScritta" x:Uid="InterruttoreScritta" Toggled="SuMostraScritta" />
                                                    <!-- Il logo accanto alla scritta: si carica solo dal PC, su un telefono che accetta le immagini. -->
                                                    <StackPanel x:Name="ZonaLogo" Orientation="Horizontal" Spacing="8">
                                                        <Button x:Name="PulsanteCaricaLogo" x:Uid="PulsanteCaricaLogo" Click="SuCaricaLogo">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                                                <TextBlock x:Uid="TestoCaricaLogo" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="PulsanteTogliLogo" x:Uid="PulsanteTogliLogo" Click="SuTogliLogo" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </local:ZonaPro>
                                            <local:ZonaPro x:Name="ZonaDoppiaVista">
                                                <ToggleSwitch x:Name="InterruttoreDoppiaVista" x:Uid="InterruttoreDoppiaVista" Toggled="SuDoppiaVista">
                                                    <ToggleSwitch.Header>
                                                        <TextBlock x:Uid="VoltoScrivania" TextWrapping="Wrap" />
                                                    </ToggleSwitch.Header>
                                                </ToggleSwitch>
                                            </local:ZonaPro>
                                            <ToggleSwitch x:Name="InterruttorePostura" x:Uid="InterruttorePostura" Toggled="SuPostura">
                                                <ToggleSwitch.Header>
                                                    <TextBlock x:Uid="PromemoriaPostura" TextWrapping="Wrap" />
                                                </ToggleSwitch.Header>
                                            </ToggleSwitch>
                                            <local:ZonaPro x:Name="ZonaGobbo">
                                                <Button x:Name="PulsanteGobbo" x:Uid="PulsanteGobbo" HorizontalAlignment="Left" Click="SuGobbo">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE736;" FontSize="14" />
                                                        <TextBlock x:Uid="TestoGobbo" />
                                                    </StackPanel>
                                                </Button>
                                            </local:ZonaPro>
                                        </StackPanel>
                                        <local:CoperturaSpenta x:Name="CoperturaEffetti" Tapped="SuComandoSenzaTelefono" />
                                    </Grid>
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource LineaTenue}" />
                            </StackPanel>

                            <!-- Regole fini (WebcamLR Pro): ISO e tempo manuali, bilanciamento del bianco, regolazioni dell'immagine. -->
                            <StackPanel>
                                <Button x:Name="IntestazioneRegoleFini" Click="SuSezione" Tag="regole" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="34">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="FrecciaRegoleFini" Glyph="&#xE76C;" FontSize="10" Foreground="{StaticResource TestoSecondario}" Width="12" />
                                        <TextBlock x:Name="NomeSezioneRegoleFini" x:Uid="TitoloRegoleFini" FontFamily="{StaticResource Titoli}" FontSize="18" />
                                        <local:SegnoPro x:Name="SegnoProRegoleFini" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="ContenutoRegoleFini" Spacing="16" Padding="0,6,0,14" Visibility="Collapsed">
                                    <local:RigaPro x:Name="RigaProRegoleFini" Visibility="Collapsed" />
                                    <Grid>
                                        <local:ZonaPro x:Name="ZonaRegoleFini" Segno="False">
                                            <StackPanel x:Name="PannelloRegoleFini" Spacing="12">
                                                <ToggleSwitch x:Name="EsposizioneManuale" x:Uid="EsposizioneManuale" IsOn="False" Toggled="SuEsposizioneManuale">
                                                    <ToggleSwitch.Header>
                                                        <TextBlock x:Uid="EsposizioneManualeISOTempo" TextWrapping="Wrap" />
                                                    </ToggleSwitch.Header>
                                                </ToggleSwitch>
                                                <StackPanel x:Name="PannelloManuale" Spacing="8" Visibility="Collapsed">
                                                    <Slider x:Name="CursoreIso" Header="ISO" Minimum="25" Maximum="3200" StepFrequency="1" Value="400" ValueChanged="SuIso" />
                                                    <!-- Solo multipli di 1/100 s: con le luci a 50 Hz non fanno bande (Protocollo.md, «tempo»). -->
                                                    <ComboBox x:Name="SceltaTempo" x:Uid="SceltaTempo" SelectedIndex="1" SelectionChanged="SuTempo">
                                                        <ComboBoxItem Content="1/25 s" Tag="25" />
                                                        <ComboBoxItem Content="1/50 s" Tag="50" />
                                                        <ComboBoxItem Content="1/100 s" Tag="100" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="BiancoAutomatico" x:Uid="BiancoAutomatico" IsOn="True" Toggled="SuBiancoAutomatico">
                                                    <ToggleSwitch.Header>
                                                        <TextBlock x:Uid="BilanciamentoBiancoAutomatico" TextWrapping="Wrap" />
                                                    </ToggleSwitch.Header>
                                                </ToggleSwitch>
                                                <Slider x:Name="CursoreBianco" x:Uid="CursoreBianco" Minimum="2500" Maximum="7500" StepFrequency="100" Value="5000" Visibility="Collapsed" ValueChanged="SuBianco" />
                                                <!-- Le quattro regolazioni dell'immagine, da −100 a +100 (0 = neutra). -->
                                                <StackPanel x:Name="PannelloRegolazioni" Spacing="4">
                                                    <Grid>
                                                        <TextBlock x:Uid="EtichettaRegolazioni" FontFamily="{StaticResource Etichette}" FontSize="14" CharacterSpacing="110" Foreground="{StaticResource TestoSecondario}" VerticalAlignment="Center" />
                                                        <HyperlinkButton x:Name="PulsanteAzzeraRegolazioni" x:Uid="PulsanteAzzeraRegolazioni" Padding="0" HorizontalAlignment="Right" Click="SuAzzeraRegolazioni" />
                                                    </Grid>
                                                    <Slider x:Name="CursoreLuminosita" x:Uid="CursoreLuminosita" Minimum="-100" Maximum="100" StepFrequency="1" Value="0" ValueChanged="SuRegolazione" />
                                                    <Slider x:Name="CursoreContrasto" x:Uid="CursoreContrasto" Minimum="-100" Maximum="100" StepFrequency="1" Value="0" ValueChanged="SuRegolazione" />
                                                    <Slider x:Name="CursoreSaturazione" x:Uid="CursoreSaturazione" Minimum="-100" Maximum="100" StepFrequency="1" Value="0" ValueChanged="SuRegolazione" />
                                                    <Slider x:Name="CursoreNitidezza" x:Uid="CursoreNitidezza" Minimum="-100" Maximum="100" StepFrequency="1" Value="0" ValueChanged="SuRegolazione" />
                                                    <!-- Passo 4 (windows.md 1.8): dopo «Azzera», per 8 secondi, «Annulla» rimette i valori di prima (anche Ctrl+Z). -->
                                                    <InfoBar x:Name="BarraAzzerate" x:Uid="BarraAzzerate" IsOpen="False" IsClosable="True" Severity="Informational" Closed="SuChiusaBarraAzzerate">
                                                        <InfoBar.ActionButton>
                                                            <Button x:Name="AzioneAzzerate" x:Uid="AzioneAzzerate" Click="SuAnnullaAzzera" />
                                                        </InfoBar.ActionButton>
                                                    </InfoBar>
                                                </StackPanel>
                                            </StackPanel>
                                        </local:ZonaPro>
                                        <local:CoperturaSpenta x:Name="CoperturaRegoleFini" Tapped="SuComandoSenzaTelefono" />
                                    </Grid>
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource LineaTenue}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <!-- In fondo, come nel disegno: «Scollega il telefono» (quello nella webcam); senza telefono, grigio. -->
                <Button x:Name="PulsanteScollega" x:Uid="PulsanteScollega" Grid.Row="1" TabIndex="10" Margin="16,8,16,16" HorizontalAlignment="Stretch" Click="SuScollega"
                        Background="Transparent" BorderBrush="{StaticResource Linea}" Foreground="{StaticResource TestoChiaro}" CornerRadius="10" Padding="0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CD;" FontSize="13" />
                        <TextBlock x:Name="TestoScollega" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ===== Impostazioni (vista «Essenziale», e anche in «Completo»): un pannello largo 360 che scorre da destra sopra il
             video, con l'elenco delle voci e una pagina per voce (Indietro per tornare), come le Impostazioni di iOS. Le pagine
             non hanno comandi propri: prendono in prestito le sezioni delle colonne (MainWindow.Viste.cs) e le rimettono al
             loro posto quando si torna indietro. Si chiude con la X, con Esc o con un clic sul video. ===== -->
        <Grid x:Name="StratoImpostazioni" Grid.Row="1" Visibility="Collapsed">
            <Border x:Name="VeloImpostazioni" Background="#33000000" Tapped="SuVeloImpostazioni" AutomationProperties.AccessibilityView="Raw" />
            <Grid x:Name="PannelloImpostazioni" x:Uid="PannelloImpostazioni" Width="360" HorizontalAlignment="Right" Background="{StaticResource BarraLaterale}"
                  BorderBrush="{StaticResource Linea}" BorderThickness="1,0,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SpostamentoImpostazioni" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="8,10,8,6" ColumnSpacing="4" BorderBrush="{StaticResource LineaTenue}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PulsanteIndietroImpostazioni" x:Uid="PulsanteIndietroImpostazioni" Click="SuIndietroImpostazioni" Background="Transparent" BorderThickness="0"
                            Padding="8,6" CornerRadius="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource Accento}" />
                            <TextBlock x:Uid="TestoIndietroImpostazioni" Foreground="{StaticResource Accento}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TitoloPaginaImpostazioni" Grid.Column="1" FontFamily="{StaticResource Titoli}" FontSize="22" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="PulsanteChiudiImpostazioni" x:Uid="PulsanteChiudiImpostazioni" Grid.Column="2" Click="SuChiudiImpostazioni" Background="Transparent"
                            BorderThickness="0" Padding="8" CornerRadius="8">
                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                    </Button>
                </Grid>
                <ScrollViewer x:Name="ScorrimentoImpostazioni" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ContenitorePagine">
                        <StackPanel x:Name="ElencoImpostazioni" Padding="8" Spacing="2" />
                        <StackPanel x:Name="ContenutoPagina" Padding="16" Spacing="16" Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>
                <!-- Ciò che le pagine non mostrano (titoli doppi, voci che hanno una pagina loro) aspetta qui, invisibile; e le
                     sezioni che stanno solo nel pannello: «Avvia con Windows» e la schermata di attesa (passo 8), e la pagina
                     «Schermo»: finestra mini e «Riempi l'inquadratura», usciti dal menu «Schermo». -->
                <StackPanel x:Name="Deposito" Grid.Row="1" Visibility="Collapsed">
                    <!-- Passo 8: «Avvia con Windows» (prima nel riquadro «Preferenze» di Account) è la pagina «Avvio» delle
                         Impostazioni. All'accesso a Windows l'app parte nascosta, con l'icona accanto all'orologio. -->
                    <StackPanel x:Name="SezioneAvvio" Spacing="2">
                        <ToggleSwitch x:Name="InterruttoreAvvio" x:Uid="InterruttoreAvvio" Toggled="SuAvvioConWindows" />
                        <TextBlock x:Uid="AllAccessoParteNascosta" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TestoSecondario}" />
                    </StackPanel>
                    <!-- Passo 8: la schermata di attesa della webcam (WebcamLR Pro), prima nel riquadro «Preferenze», sta nella pagina
                         «Uscite»: è quello che vedono le altre app. -->
                    <StackPanel x:Name="SezioneAttesa" Spacing="6">
                        <local:ZonaPro x:Name="ZonaAttesa">
                            <ComboBox x:Name="SceltaAttesa" x:Uid="SceltaAttesa" HorizontalAlignment="Stretch" SelectionChanged="SuSchermataAttesa">
                                <ComboBox.Header>
                                    <TextBlock x:Uid="SchermataAttesa" />
                                </ComboBox.Header>
                                <ComboBoxItem Content="WebcamLR" Tag="webcamlr" />
                                <ComboBoxItem x:Uid="VoceAttesaNero" Tag="nero" />
                                <ComboBoxItem x:Uid="VoceAttesaImmagine" Tag="immagine" />
                                <ComboBoxItem x:Uid="VoceAttesaSfocata" Tag="sfocata" />
                            </ComboBox>
                        </local:ZonaPro>
                        <Button x:Name="PulsanteImmagineAttesa" x:Uid="PulsanteImmagineAttesa" Click="SuScegliImmagineAttesa" Visibility="Collapsed" />
                        <TextBlock x:Name="NotaAttesa" x:Uid="NotaAttesa" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                        <TextBlock x:Name="ErroreImmagineAttesa" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Ambra}" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="SezioneSchermo" Spacing="18">
                        <StackPanel Spacing="2">
                            <!-- Vale solo per l'anteprima qui: le altre app ricevono il video intero. -->
                            <ToggleSwitch x:Name="InterruttoreRiempi" x:Uid="PulsanteRiempi" Toggled="SuRiempi">
                                <ToggleSwitch.Header>
                                    <TextBlock x:Uid="TestoRiempi" TextWrapping="Wrap" />
                                </ToggleSwitch.Header>
                            </ToggleSwitch>
                            <TextBlock x:Uid="NotaRiempi" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <Button x:Name="PulsanteMini" x:Uid="PulsanteMini" Click="SuFinestraMini">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEE49;" FontSize="14" />
                                    <TextBlock x:Uid="TestoMini" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Uid="NotaMini" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
