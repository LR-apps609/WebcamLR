<?xml version="1.0" encoding="utf-8"?>
<!-- Finestra del ricevitore (bozza grafica, Windows 1). -->
<Window
    x:Class="WebcamLR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WebcamLR">

    <Grid Background="{StaticResource Fondo}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Sezioni e telefono -->
        <StackPanel Grid.Column="0" Padding="6,8" Spacing="16">
            <ListView SelectedIndex="0">
                <ListViewItem Content="Anteprima" />
                <ListViewItem Content="Telefoni" />
                <ListViewItem Content="Registrazioni" />
                <ListViewItem Content="Diagnostica" />
            </ListView>
            <StackPanel Padding="10,0" Spacing="6">
                <TextBlock Text="TELEFONO" FontFamily="{StaticResource Etichette}" FontSize="14" CharacterSpacing="80" Foreground="{StaticResource TestoSecondario}" />
                <Border x:Name="SchedaTelefono" Background="{StaticResource Scheda}" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="NomeTelefono" Text="In attesa di un telefono" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DettagliTelefono" Text="" FontFamily="{StaticResource Numeri}" FontSize="12" Foreground="{StaticResource TestoSecondario}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Anteprima -->
        <ScrollViewer Grid.Column="1" Background="{StaticResource Pannello}" BorderBrush="{StaticResource Linea}" BorderThickness="1,1,1,0" CornerRadius="8,0,0,0">
            <StackPanel Padding="16" Spacing="12">
                <Grid>
                    <TextBlock Text="Anteprima" FontFamily="{StaticResource Titoli}" FontSize="32" />
                    <Border x:Name="PillolaStato" HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" Padding="12,0" CornerRadius="15" BorderBrush="#3C4844" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="PuntoStato" Width="8" Height="8" Stroke="{StaticResource TestoSecondario}" StrokeThickness="1.5" />
                            <TextBlock x:Name="TestoStato" Text="NESSUN TELEFONO" FontFamily="{StaticResource Etichette}" FontSize="16" CharacterSpacing="60" Foreground="{StaticResource TestoSecondario}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                         Title="Microfono virtuale non installato."
                         Message="Il video funzionerà già; per usare l'audio del telefono servirà un piccolo driver (round 9)." />

                <Grid Background="Black" CornerRadius="8">
                    <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <MediaPlayerElement.RenderTransform>
                            <ScaleTransform x:Name="Specchio" ScaleX="1" />
                        </MediaPlayerElement.RenderTransform>
                    </MediaPlayerElement>
                    <Viewbox Stretch="Uniform">
                        <Grid Width="1600" Height="900">
                            <StackPanel x:Name="Segnaposto" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                <FontIcon Glyph="&#xE8EA;" FontSize="72" Foreground="{StaticResource TestoSecondario}" />
                                <TextBlock x:Name="MessaggioAnteprima" Text="Apri WebcamLR sull'iPhone e scegli questo PC" FontSize="36" Foreground="{StaticResource TestoSecondario}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1200" />
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Fondo}" CornerRadius="6" Padding="12,8">
                        <TextBlock x:Name="TestoStatistiche" Text="Nessun telefono collegato" FontFamily="{StaticResource Numeri}" FontSize="12" Foreground="{StaticResource TestoSecondario}" />
                    </Border>
                    <ToggleButton x:Name="PulsanteSpecchia" Grid.Column="1" Content="Specchia" VerticalAlignment="Stretch" Click="SuSpecchia"
                                  ToolTipService.ToolTip="Specchia l'anteprima, solo in questa finestra" />
                    <Button x:Name="PulsanteScollega" Grid.Column="2" Content="Scollega il telefono" VerticalAlignment="Stretch" Visibility="Collapsed" Click="SuScollega"
                            ToolTipService.ToolTip="Chiude il collegamento: l'iPhone non si ricollega da solo" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Fotocamera e nuovo telefono -->
        <StackPanel Grid.Column="2" Padding="16" Spacing="12" Background="{StaticResource Pannello}" BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,0">
            <TextBlock Text="Fotocamera" FontFamily="{StaticResource Titoli}" FontSize="24" />
            <TextBlock x:Name="DettagliFotocamera" Text="I controlli si attivano quando un telefono è collegato (round 4)." TextWrapping="Wrap" Foreground="{StaticResource TestoSecondario}" />

            <!-- Comandi della fotocamera dell'iPhone (round 4) -->
            <StackPanel x:Name="PannelloComandi" Spacing="10" Visibility="Collapsed">
                <DropDownButton x:Name="PulsanteProfili" Content="Profili" HorizontalAlignment="Stretch">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MenuProfili" Placement="Bottom" Opening="SuAperturaProfili" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ComboBox x:Name="SceltaObiettivo" Header="Obiettivo" HorizontalAlignment="Stretch" SelectionChanged="SuObiettivo" />
                <Slider x:Name="CursoreZoom" Header="Zoom" Minimum="1" Maximum="10" StepFrequency="0.1" Value="1" ValueChanged="SuZoom" />
                <Slider x:Name="CursoreEsposizione" Header="Esposizione" Minimum="-2" Maximum="2" StepFrequency="0.1" Value="0" ValueChanged="SuEsposizione" />
                <ToggleSwitch x:Name="EsposizioneManuale" Header="Esposizione manuale (ISO e tempo)" IsOn="False" Visibility="Collapsed" Toggled="SuEsposizioneManuale" />
                <StackPanel x:Name="PannelloManuale" Spacing="8" Visibility="Collapsed">
                    <Slider x:Name="CursoreIso" Header="ISO" Minimum="25" Maximum="3200" StepFrequency="1" Value="400" ValueChanged="SuIso" />
                    <ComboBox x:Name="SceltaTempo" Header="Tempo" SelectedIndex="3" SelectionChanged="SuTempo">
                        <ComboBoxItem Content="1/25 s" Tag="25" />
                        <ComboBoxItem Content="1/30 s" Tag="30" />
                        <ComboBoxItem Content="1/50 s" Tag="50" />
                        <ComboBoxItem Content="1/60 s" Tag="60" />
                        <ComboBoxItem Content="1/100 s" Tag="100" />
                        <ComboBoxItem Content="1/120 s" Tag="120" />
                        <ComboBoxItem Content="1/250 s" Tag="250" />
                        <ComboBoxItem Content="1/500 s" Tag="500" />
                    </ComboBox>
                </StackPanel>
                <ToggleSwitch x:Name="BiancoAutomatico" Header="Bilanciamento del bianco automatico" IsOn="True" Toggled="SuBiancoAutomatico" />
                <Slider x:Name="CursoreBianco" Header="Bianco (kelvin)" Minimum="2500" Maximum="7500" StepFrequency="100" Value="5000" Visibility="Collapsed" ValueChanged="SuBianco" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="PulsanteTorcia" Content="Torcia" Click="SuTorcia" />
                    <Button Content="Fuoco automatico" Click="SuFuoco" />
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource Scheda}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nuovo telefono?" FontWeight="SemiBold" />
                    <Border Background="White" CornerRadius="6" Padding="8" HorizontalAlignment="Left">
                        <Image x:Name="ImmagineQR" Width="160" Height="160" AutomationProperties.Name="QR code per collegare l'iPhone" />
                    </Border>
                    <TextBlock Text="Sull'iPhone: «Inquadra il QR code del computer»." TextWrapping="Wrap" Foreground="{StaticResource TestoSecondario}" />
                    <TextBlock x:Name="IndirizzoScritto" Text="" FontFamily="{StaticResource Numeri}" FontSize="12" Foreground="{StaticResource TestoSecondario}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
