<?xml version="1.0" encoding="utf-8"?>
<!-- I componenti di WebcamLR per Windows: uno stile per ruolo del catalogo (Documenti/Stile.md), tutti fatti con i token di
     Token.xaml. Incluso in App.xaml dopo i token. Qui niente misure né colori scritti a mano: se serve un valore nuovo, va
     in Documenti/token.json (soloWindows) e si rilancia Strumenti/genera_token.py.
     1.0 beta 4 «Volto nuovo», direzione A «Regia pulita, rifinita» (come i componenti di Stile per il Mac):
     - un solo pieno per contesto, il primario; «acceso» non è mai pieno: accentoTenue con il bordo accento e la scritta;
     - secondario trasparente con contornoControllo (4,30:1 sul fondo, 3:1 o più fino al pannello);
     - distruttivo solo testo, mai pieno né bordato, mai il più evidente;
     - chip informativi bordati, mai pieni; pillola piena solo IN ONDA;
     - avvisi: ambra tenue con il bordo (attenzione), pannello con il contorno (informazione); mai corallo.
     I colori si leggono con ThemeResource: con il Contrasto elevato di Windows diventano quelli di sistema (Token.xaml,
     dizionario «HighContrast»). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- I token anche qui: gli stili li trovano senza dipendere dall'ordine dei dizionari di App.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Token.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- I colori dei controlli di WinUI usati senza stile (pulsanti, interruttori a pulsante, avvisi), con l'aspetto della
         direzione A: così anche i pulsanti delle InfoBar e delle finestre di dialogo e i segmenti dell'obiettivo seguono
         il catalogo. Con il Contrasto elevato il dizionario «HighContrast» è vuoto apposta: restano i colori di sistema
         di WinUI (senza, varrebbe «Default»). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Secondario: trasparente con contornoControllo; un gradino più chiaro al passaggio e alla pressione. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SfondoSopra" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SfondoPremuto" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource ColoreContornoControllo}" Opacity="{StaticResource OpacitaSpento}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ColoreTesto}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ColoreTesto}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ColoreTestoTenue}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource ColoreTesto}" Opacity="{StaticResource OpacitaSpento}" />

            <!-- Interruttore a pulsante (Torcia, segmenti dell'obiettivo, viste del menu «Schermo»): spento come il secondario,
                 acceso accentoTenue con il bordo accento e il testo accentoChiaro (8,35:1). Mai pieno: il pieno è del primario. -->
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SfondoSopra" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SfondoPremuto" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="{StaticResource ColoreContornoControllo}" Opacity="{StaticResource OpacitaSpento}" />
            <SolidColorBrush x:Key="ToggleButtonForeground" Color="{StaticResource ColoreTesto}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{StaticResource ColoreTesto}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{StaticResource ColoreTestoTenue}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{StaticResource ColoreTesto}" Opacity="{StaticResource OpacitaSpento}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource ColoreAccentoTenue}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource ColoreAccentoTenue}" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SfondoPremuto" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{StaticResource ColoreAccentoTenue}" Opacity="{StaticResource OpacitaSpento}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{StaticResource ColoreAccento}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{StaticResource ColoreAccentoChiaro}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{StaticResource ColoreAccento}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="{StaticResource ColoreAccento}" Opacity="{StaticResource OpacitaSpento}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource ColoreAccentoChiaro}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource ColoreAccentoChiaro}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource ColoreAccento}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{StaticResource ColoreAccentoChiaro}" Opacity="{StaticResource OpacitaSpento}" />

            <!-- Avvisi (InfoBar): attenzione ed errore in ambra tenue (il corallo è solo «in onda» e registrazione),
                 informazione e riuscita sul pannello; il contorno dei controlli intorno, l'icona nel colore del tono. -->
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="{StaticResource ColoreAmbraTenue}" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="{StaticResource ColoreAmbraTenue}" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{StaticResource ColorePannello}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="{StaticResource ColorePannello}" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="{StaticResource ColoreAmbra}" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="{StaticResource ColoreAmbra}" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{StaticResource ColoreAccento}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="{StaticResource ColoreVerde}" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconForeground" Color="{StaticResource ColoreFondo}" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconForeground" Color="{StaticResource ColoreFondo}" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconForeground" Color="{StaticResource ColoreFondo}" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconForeground" Color="{StaticResource ColoreFondo}" />
            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="{StaticResource ColoreContornoControllo}" />

            <!-- Finestre di dialogo (ContentDialog: «App e assistenza», «WebcamLR Pro», le domande): superfici a gradini
                 come il pannello Impostazioni. Il contenuto su «pannello», la fascia dei pulsanti un gradino sotto
                 (barraLaterale), il bordo contornoControllo (3,14:1 sul pannello). Così contornoControllo dei pulsanti e
                 dei campi resta a 3:1 o più anche dentro, e testoSecondario a 4,5:1 (5,32:1). Le schede dentro salgono
                 a pannelloChiaro con contornoSuRialzato e le note in testoTenue. Prima: il grigio di WinUI (#2B2B2B). -->
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource ColorePannello}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource ColoreBarraLaterale}" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="{StaticResource ColoreLinea}" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource ColoreTesto}" />

            <!-- Schede di una finestra a schede (Pivot di «App e assistenza»): la scheda scelta nel testo, le altre in
                 testoSecondario (5,32:1 sul pannello); la riga sotto la scelta resta nell'accento. -->
            <SolidColorBrush x:Key="PivotHeaderItemForegroundUnselected" Color="{StaticResource ColoreTestoSecondario}" />
            <SolidColorBrush x:Key="PivotHeaderItemForegroundSelected" Color="{StaticResource ColoreTesto}" />

            <!-- Campi (TextBox, ComboBox: «Segnala un bug», ricerca delle domande, gobbo, scritta, scelte delle colonne):
                 contornoControllo intorno (4,30:1 sul fondo, 3,14:1 sul pannello) al posto della riga quasi invisibile di
                 WinUI. Con lo stato attivo resta la riga nell'accento di WinUI. -->
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource ColoreContornoControllo}" Opacity="{StaticResource OpacitaSpento}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource ColoreContornoControllo}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource ColoreContornoControllo}" Opacity="{StaticResource OpacitaSpento}" />

            <!-- Voci che si aprono (Expander: le domande frequenti): schede un gradino sopra il pannello del dialogo,
                 pannelloChiaro con contornoSuRialzato (3,04:1 sul rialzato, 3,68:1 sul pannello intorno); la risposta
                 dentro in testoTenue. -->
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource ColorePannelloChiaro}" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{StaticResource ColoreContornoSuRialzato}" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="{StaticResource ColoreContornoSuRialzato}" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="{StaticResource ColoreContornoSuRialzato}" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource ColorePannelloChiaro}" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="{StaticResource ColoreContornoSuRialzato}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Testi ===== -->

    <!-- La base di ogni testo: Barlow. Lo stile implicito dei TextBlock (App.xaml) e gli stili di testo con nome partono
         da qui, perché uno stile con nome sostituisce quello implicito. -->
    <Style x:Key="TestoBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Corpo}" />
    </Style>

    <!-- Etichetta di sezione: TELEFONI, CONNESSIONE, USCITE, OBIETTIVO, REGOLAZIONI, i titoli dei menu della qualità e
         della strada e delle pagine del pannello Impostazioni. -->
    <Style x:Key="EtichettaSezione" TargetType="TextBlock" BasedOn="{StaticResource TestoBase}">
        <Setter Property="FontFamily" Value="{StaticResource Etichette}" />
        <Setter Property="FontSize" Value="{StaticResource MisuraSezione}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource SpaziaturaEtichette}" />
        <Setter Property="Foreground" Value="{ThemeResource TestoSecondario}" />
    </Style>

    <!-- Il nome sotto l'icona di un comando di regia, e l'icona. -->
    <Style x:Key="TestoComandoRegia" TargetType="TextBlock" BasedOn="{StaticResource TestoBase}">
        <Setter Property="FontSize" Value="{StaticResource MisuraTestoPiccolo}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="IconaComandoRegia" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource MisuraIconaComando}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- La riga di stato scritta sotto il nome (dalla direzione B): «Acceso» nell'accento, «● 12:31» in corallo solo mentre
         registra, vuota altrimenti. Lo spazio resta sempre: i comandi sono alti uguali. Lo stato si legge senza il colore. -->
    <Style x:Key="StatoComandoRegia" TargetType="TextBlock" BasedOn="{StaticResource TestoBase}">
        <Setter Property="FontSize" Value="{StaticResource MisuraDettaglio}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioComodo}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource Accento}" />
    </Style>

    <!-- Il testo di una pillola di stato (NESSUN TELEFONO, IN ONDA, MI RICOLLEGO…). -->
    <Style x:Key="TestoPillola" TargetType="TextBlock" BasedOn="{StaticResource TestoBase}">
        <Setter Property="FontFamily" Value="{StaticResource Etichette}" />
        <Setter Property="FontSize" Value="{StaticResource MisuraRilievo}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource SpaziaturaPillola}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Pulsanti ===== -->

    <!-- Primario contestuale: il pieno nell'accento (AccentButtonStyle di WinUI, testo scuro: App.xaml), uno per contesto.
         È l'unico pieno: acceso, chip e distruttivi non lo sono mai. -->
    <Style x:Key="PulsantePrimario" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource CorpoForte}" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioControllo}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPulsante}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioAmpio}" />
    </Style>

    <!-- Secondario bordato: fondo trasparente e contornoControllo (i colori dei pulsanti di WinUI, qui sopra). Alto almeno
         32, l'area di clic più di 24×24. -->
    <Style x:Key="PulsanteSecondario" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource ContornoControllo}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource Testo}" />
        <Setter Property="FontFamily" Value="{StaticResource CorpoEvidente}" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioControllo}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPulsante}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioAmpio}" />
    </Style>
    <!-- Lo stesso secondario dentro un pannello rialzato (pannelloChiaro): contornoSuRialzato, 3:1 anche lì. -->
    <Style x:Key="PulsanteSecondarioSuRialzato" TargetType="Button" BasedOn="{StaticResource PulsanteSecondario}">
        <Setter Property="BorderBrush" Value="{ThemeResource ContornoSuRialzato}" />
    </Style>

    <!-- Distruttivo (Scollega, Rimuovi, Togli, Azzera): solo testo (e l'icona), mai pieno né bordato, mai il più evidente.
         Il colore è quello del testo, non il corallo (il corallo è solo «in onda»). Area di clic almeno 24 di altezza. -->
    <Style x:Key="PulsanteDistruttivo" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource Testo}" />
        <Setter Property="FontFamily" Value="{StaticResource CorpoEvidente}" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioPiccolo}" />
        <Setter Property="Padding" Value="{StaticResource PaddingDistruttivo}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioLargo}" />
        <Setter Property="MinWidth" Value="{StaticResource SpazioLargo}" />
    </Style>

    <!-- Link: testo nell'accento. Area di clic almeno 24 di altezza (prima la riga di testo, 16-18). -->
    <Style x:Key="PulsanteLink" TargetType="HyperlinkButton">
        <Setter Property="Padding" Value="{StaticResource PaddingLink}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioLargo}" />
        <Setter Property="FontSize" Value="{StaticResource MisuraCorpo}" />
        <Setter Property="Foreground" Value="{ThemeResource Accento}" />
    </Style>

    <!-- Pulsanti senza fondo né bordo che non sono link: icone (Chiudi, Indietro, le freccine dei comandi di regia), le
         intestazioni delle sezioni richiudibili, «Registro» e «Profili salvati». Padding e misura li dà chi lo usa; l'area
         di clic resta almeno 24×24. -->
    <Style x:Key="PulsanteDiscreto" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="{StaticResource SpazioLargo}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioLargo}" />
    </Style>

    <!-- Comando di regia (Specchia, Sfondo, Foto, Registra, Schermo e le tre viste): icona sopra, nome e riga di stato
         sotto, larghi uguali. Spento trasparente con contornoControllo (4,30:1 sul fondo della barra); acceso (Specchia,
         Sfondo, la vista di adesso) accentoTenue con il bordo accento da 1,5 e il testo accentoChiaro, con «Acceso» nella
         riga di stato: mai pieno, il pieno è del primario. Spento perché non si può usare: tutto a OpacitaSpento, una volta.
         Lo stesso modello per Button e ToggleButton (un Button non va mai negli stati «Checked»). -->
    <Style x:Key="ComandoRegia" TargetType="ButtonBase">
        <Setter Property="Width" Value="80" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioAmpio}" />
        <Setter Property="Padding" Value="{StaticResource PaddingComando}" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioControllo}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource ContornoControllo}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource Testo}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Superficie" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Superficie.Background" Value="{ThemeResource SfondoSopra}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Superficie.Background" Value="{ThemeResource SfondoPremuto}" />
                                        <Setter Target="Contenuto.Foreground" Value="{ThemeResource TestoTenue}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Superficie.Opacity" Value="{StaticResource OpacitaSpento}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Superficie.Background" Value="{ThemeResource AccentoTenue}" />
                                        <Setter Target="Superficie.BorderBrush" Value="{ThemeResource Accento}" />
                                        <Setter Target="Superficie.BorderThickness" Value="{StaticResource BordoAcceso}" />
                                        <Setter Target="Contenuto.Foreground" Value="{ThemeResource AccentoChiaro}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Superficie.Background" Value="{ThemeResource AccentoTenue}" />
                                        <Setter Target="Superficie.BorderBrush" Value="{ThemeResource AccentoChiaro}" />
                                        <Setter Target="Superficie.BorderThickness" Value="{StaticResource BordoAcceso}" />
                                        <Setter Target="Contenuto.Foreground" Value="{ThemeResource AccentoChiaro}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Superficie.Background" Value="{ThemeResource Pannello}" />
                                        <Setter Target="Superficie.BorderBrush" Value="{ThemeResource Accento}" />
                                        <Setter Target="Superficie.BorderThickness" Value="{StaticResource BordoAcceso}" />
                                        <Setter Target="Contenuto.Foreground" Value="{ThemeResource Accento}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Superficie.Background" Value="{ThemeResource AccentoTenue}" />
                                        <Setter Target="Superficie.BorderBrush" Value="{ThemeResource Accento}" />
                                        <Setter Target="Superficie.BorderThickness" Value="{StaticResource BordoAcceso}" />
                                        <Setter Target="Contenuto.Foreground" Value="{ThemeResource AccentoChiaro}" />
                                        <Setter Target="Superficie.Opacity" Value="{StaticResource OpacitaSpento}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Contenuto" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruttore a un clic fuori dalla barra (Torcia, segmenti dell'obiettivo): i colori dei ToggleButton qui sopra,
         con la forma del secondario. -->
    <Style x:Key="PulsanteInterruttore" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource CorpoEvidente}" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioControllo}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPulsante}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioAmpio}" />
        <Setter Property="MinWidth" Value="{StaticResource SpazioLargo}" />
    </Style>

    <!-- Le voci dei menu fatti a mano (WebcamLR, qualità, strada, profili, Impostazioni): tutta la riga cliccabile. -->
    <Style x:Key="VoceMenu" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource PaddingVoce}" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioPiccolo}" />
        <Setter Property="MinHeight" Value="{StaticResource SpazioAmpio}" />
    </Style>

    <!-- ===== Chip, pillole, avvisi ===== -->

    <!-- Chip informativo che si clicca (qualità, strada, telefono sul video, «Personalizzato», «Aggiornamento disponibile»):
         un'informazione, non un'azione. Bordato, mai pieno: sopra il video velo medio con contornoSuVideo (BordoEtichetta);
         su un pannello chi lo usa toglie il velo (ChipInformativoPannello). Alto 28. -->
    <Style x:Key="ChipInformativo" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource VeloEtichetta}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BordoEtichetta}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource Testo}" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioPiccolo}" />
        <Setter Property="Padding" Value="{StaticResource PaddingChip}" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <!-- Lo stesso chip fuori dal video (intestazione, colonna): solo il contorno dei controlli. -->
    <Style x:Key="ChipInformativoPannello" TargetType="Button" BasedOn="{StaticResource ChipInformativo}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource ContornoControllo}" />
    </Style>

    <!-- Lo stesso chip, solo da leggere (CAM 1, nome della CAM 2, «IN ARRIVO», «più veloce ora»). -->
    <Style x:Key="ChipInformativoFisso" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VeloEtichetta}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BordoEtichetta}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioPiccolo}" />
        <Setter Property="Padding" Value="{StaticResource PaddingChip}" />
    </Style>

    <!-- Pillola di stato (accanto al nome, e MI RICOLLEGO sul video): capsula. Piena solo IN ONDA (tallyPieno e
         TestoInOnda, 5,15:1); IN PAUSA e MI RICOLLEGO ambra tenue con il bordo ambra; COLLEGATO e NESSUN TELEFONO solo il
         contorno dei controlli. Fondo e bordo li cambia lo stato (MainWindow.Mostra). -->
    <Style x:Key="PillolaStato" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RaggioCapsula}" />
        <Setter Property="Padding" Value="{StaticResource PaddingPillola}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="BorderBrush" Value="{ThemeResource ContornoControllo}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- La barra tally (dalla direzione B): 3 px di corallo sul bordo alto del video quando un'app usa il video. Si vede
         anche nella finestra mini e nello schermo intero. -->
    <Style x:Key="BarraTally" TargetType="Rectangle">
        <Setter Property="Height" Value="{StaticResource SpazioBarraTally}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Fill" Value="{ThemeResource Tally}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Avviso: le InfoBar di WinUI (restano finché la causa c'è o finché le chiudi), con i colori qui sopra. -->
    <Style x:Key="Avviso" TargetType="InfoBar">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource RaggioPannello}" />
    </Style>
</ResourceDictionary>
