<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WebcamLR</RootNamespace>
    <AssemblyName>WebcamLR</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- L'architettura dalla piattaforma, come nel modello di WinUI. Da riga di comando dotnet build non la sceglie
         da solo: senza RuntimeIdentifier le DLL native dei pacchetti restano in runtimes\win-x64\native invece che accanto
         all'exe, e un'app WinUI non pacchettizzata con WindowsAppSDKSelfContained può non partire. Con il RuntimeIdentifier
         l'exe sta in bin\x64\Debug\net8.0-windows10.0.19041.0\win-x64\ (win-arm64 per ARM64), con la cartella Webcam accanto. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- Il .NET resta quello installato (serve comunque l'SDK per compilare): solo il Windows App SDK è incluso. -->
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <!-- App non pacchettizzata: si avvia con un doppio clic sull'exe, senza installer. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- La webcam (1.24) legge i byte del fotogramma decodificato direttamente dalla memoria. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <!-- Testi in italiano e inglese (W2): Strings\it-IT\Resources.resw e Strings\en-US\Resources.resw, che il Windows App SDK
         compila da solo in WebcamLR.pri accanto all'exe (anche senza pacchetto). La lingua la sceglie Testi.Imposta all'avvio;
         questa è solo quella di ripiego di MRT se la lingua di Windows non è né l'una né l'altra e l'override non vale. -->
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- Icona nella barra delle applicazioni, accanto all'orologio (licenza MIT). -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <!-- DPAPI: la chiave del PC (collegamento sicuro, 0.10) si salva cifrata per l'utente di Windows. Microsoft, licenza MIT. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Barlow, Barlow Condensed e IBM Plex Mono (SIL Open Font License), come nelle app Apple (Stile/Sources/Stile/Caratteri). -->
    <Content Include="Assets\Caratteri\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WebcamLR.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebcamLR.Protocollo\WebcamLR.Protocollo.csproj" />
    <ProjectReference Include="..\WebcamLR.Ricevitore\WebcamLR.Ricevitore.csproj" />
    <ProjectReference Include="..\WebcamLR.Webcam.Logica\WebcamLR.Webcam.Logica.csproj" />
    <!-- Il microfono del telefono (W2): decodificatore AAC di Media Foundation e uscita audio WASAPI. -->
    <ProjectReference Include="..\WebcamLR.Microfono\WebcamLR.Microfono.csproj" />
  </ItemGroup>

  <!-- Webcam virtuale (1.24): la sorgente per Frame Server e il suo installatore si compilano a parte, per la stessa
       architettura dell'app, e finiscono nella cartella «Webcam» accanto a WebcamLR.exe. Da lì l'installatore li copia
       in Programmi. Non sono riferimenti normali: l'app non li carica mai. -->
  <!-- Windows 10 (1.25, P23): il filtro DirectShow, anche a 32 bit nella sottocartella «Webcam\x86» per le app a 32 bit. -->
  <ItemGroup>
    <ProgettiWebcam Include="..\WebcamLR.Webcam\WebcamLR.Webcam.csproj;..\WebcamLR.Webcam.Installa\WebcamLR.Webcam.Installa.csproj;..\WebcamLR.Webcam.DirectShow\WebcamLR.Webcam.DirectShow.csproj" />
    <FiltroX86 Include="..\WebcamLR.Webcam.DirectShow\WebcamLR.Webcam.DirectShow.csproj" />
  </ItemGroup>
  <Target Name="CompilaWebcam" AfterTargets="Build">
    <PropertyGroup>
      <RidWebcam>$(RuntimeIdentifier)</RidWebcam>
      <RidWebcam Condition="'$(RidWebcam)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RidWebcam>
      <RidWebcam Condition="'$(RidWebcam)' == ''">win-x64</RidWebcam>
    </PropertyGroup>
    <MSBuild Projects="@(ProgettiWebcam)" Targets="Restore" Properties="RuntimeIdentifier=$(RidWebcam);_RipristinoWebcam=1" />
    <MSBuild Projects="@(ProgettiWebcam)" Targets="Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RidWebcam)">
      <Output TaskParameter="TargetOutputs" ItemName="UscitaProgettiWebcam" />
    </MSBuild>
    <ItemGroup>
      <FileWebcam Include="%(UscitaProgettiWebcam.RootDir)%(UscitaProgettiWebcam.Directory)*.dll;%(UscitaProgettiWebcam.RootDir)%(UscitaProgettiWebcam.Directory)*.json;%(UscitaProgettiWebcam.RootDir)%(UscitaProgettiWebcam.Directory)*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(FileWebcam)" DestinationFolder="$(OutDir)Webcam" SkipUnchangedFiles="true" />

    <!-- Senza Platform: quella dell'app (x64 o ARM64, passata da riga di comando) arriverebbe anche qui e con win-x86
         darebbe l'errore NETSDK1032. Senza, l'architettura x86 la decide il RuntimeIdentifier. -->
    <MSBuild Projects="@(FiltroX86)" Targets="Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x86" RemoveProperties="Platform">
      <Output TaskParameter="TargetOutputs" ItemName="UscitaFiltroX86" />
    </MSBuild>
    <ItemGroup>
      <FileFiltroX86 Include="%(UscitaFiltroX86.RootDir)%(UscitaFiltroX86.Directory)*.dll;%(UscitaFiltroX86.RootDir)%(UscitaFiltroX86.Directory)*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(FileFiltroX86)" DestinationFolder="$(OutDir)Webcam\x86" SkipUnchangedFiles="true" />
  </Target>

</Project>
