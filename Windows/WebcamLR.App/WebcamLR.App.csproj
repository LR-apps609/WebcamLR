<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WebcamLR</RootNamespace>
    <AssemblyName>WebcamLR</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- App non pacchettizzata: si avvia con un doppio clic sull'exe, senza installer. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- La webcam (1.24) legge i byte del fotogramma decodificato direttamente dalla memoria. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- Icona nella barra delle applicazioni, accanto all'orologio (licenza MIT). -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <!-- DPAPI: la chiave del PC (collegamento sicuro, 0.10) si salva cifrata per l'utente di Windows. Microsoft, licenza MIT. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Barlow Condensed e IBM Plex Mono (SIL Open Font License), come nelle app Apple. -->
    <Content Include="Assets\Caratteri\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WebcamLR.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebcamLR.Protocollo\WebcamLR.Protocollo.csproj" />
    <ProjectReference Include="..\WebcamLR.Ricevitore\WebcamLR.Ricevitore.csproj" />
    <ProjectReference Include="..\WebcamLR.Webcam.Logica\WebcamLR.Webcam.Logica.csproj" />
  </ItemGroup>

  <!-- Webcam virtuale (1.24): la sorgente per Frame Server e il suo installatore si compilano a parte, per la stessa
       architettura dell'app, e finiscono nella cartella «Webcam» accanto a WebcamLR.exe. Da lì l'installatore li copia
       in Programmi. Non sono riferimenti normali: l'app non li carica mai. -->
  <ItemGroup>
    <ProgettiWebcam Include="..\WebcamLR.Webcam\WebcamLR.Webcam.csproj;..\WebcamLR.Webcam.Installa\WebcamLR.Webcam.Installa.csproj" />
  </ItemGroup>
  <Target Name="CompilaWebcam" AfterTargets="Build">
    <PropertyGroup>
      <RidWebcam>$(RuntimeIdentifier)</RidWebcam>
      <RidWebcam Condition="'$(RidWebcam)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RidWebcam>
      <RidWebcam Condition="'$(RidWebcam)' == ''">win-x64</RidWebcam>
    </PropertyGroup>
    <MSBuild Projects="@(ProgettiWebcam)" Targets="Restore" Properties="RuntimeIdentifier=$(RidWebcam);_RipristinoWebcam=1" />
    <MSBuild Projects="@(ProgettiWebcam)" Targets="Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RidWebcam)">
      <Output TaskParameter="TargetOutputs" ItemName="UscitaProgettiWebcam" />
    </MSBuild>
    <ItemGroup>
      <FileWebcam Include="%(UscitaProgettiWebcam.RootDir)%(UscitaProgettiWebcam.Directory)*.dll;%(UscitaProgettiWebcam.RootDir)%(UscitaProgettiWebcam.Directory)*.json;%(UscitaProgettiWebcam.RootDir)%(UscitaProgettiWebcam.Directory)*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(FileWebcam)" DestinationFolder="$(OutDir)Webcam" SkipUnchangedFiles="true" />
  </Target>

</Project>
