<Project Sdk="Microsoft.NET.Sdk">

  <!-- Il motore effetti sul computer (Documenti/Effetti su Windows.md): il ritaglio della persona con ONNX Runtime e la
       composizione degli effetti sul processore (cartella Motore).
       Senza interfaccia e senza API di Windows: si prova anche su Linux con il motore sul processore. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WebcamLR.Effetti</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- I cicli sui pixel della resa (cartella Motore) leggono e scrivono con i puntatori: niente controlli per byte. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ONNX Runtime (Microsoft, licenza MIT). Su Windows il pacchetto DirectML: scheda video con DirectX 12 e, dentro lo
       stesso pacchetto, il processore come ripiego; porta con sé Microsoft.AI.DirectML (licenza Microsoft ridistribuibile,
       solo Windows: Licenze/DirectML.txt). Altrove (Linux, macOS: solo per i test) il pacchetto normale, solo processore.
       Stessa versione per tutti e due: la parte .NET (Microsoft.ML.OnnxRuntime.Managed) è la stessa. 1.24.4 è l'ultima
       pubblicata del pacchetto DirectML (ottobre 2026). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <!-- Qualità 5: la composizione dello sfondo sulla scheda video con Direct3D 11 (cartella SchedaVideo). Vortice.Windows
       (Amer Koleci, licenza MIT): solo codice .NET che chiama d3d11.dll e d3dcompiler_47.dll di Windows, quindi si compila
       anche su Linux (dove la scheda video non si apre e resta il processore). Porta con sé Vortice.DXGI, Vortice.DirectX,
       Vortice.Mathematics e SharpGen.Runtime(.COM), tutti MIT: Licenze/MIT-Vortice.txt. -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <!-- Lo shader (HLSL) si compila all'avvio con D3DCompile: nella libreria c'è il testo, nessun .cso. -->
  <ItemGroup>
    <EmbeddedResource Include="SchedaVideo\Composizione.hlsl" LogicalName="Composizione.hlsl" />
  </ItemGroup>

  <!-- Gli identificativi di filtri, sfondi e sfondi pronti (Documenti/Protocollo.md), per le impostazioni del motore. -->
  <ItemGroup>
    <ProjectReference Include="..\WebcamLR.Protocollo\WebcamLR.Protocollo.csproj" />
  </ItemGroup>

  <!-- I modelli (da MediaPipe, Apache 2.0) e le licenze, nella cartella dell'exe: Modelli\ e Licenze\. Vanno anche
       nell'uscita dei progetti che fanno riferimento a questo. -->
  <ItemGroup>
    <Content Include="Modelli\*.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Licenze\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
