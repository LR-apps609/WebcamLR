<Project Sdk="Microsoft.NET.Sdk">

  <!-- Il cuore del ricevitore Windows, senza interfaccia: rete, sessione, latenza.
       Gira anche su Linux e macOS, così si può provare con un telefono simulato. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WebcamLR.Ricevitore</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- QR code in PNG, senza System.Drawing (licenza MIT). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebcamLR.Protocollo\WebcamLR.Protocollo.csproj" />
    <!-- Il motore effetti (Documenti/Effetti su Windows.md): le regole che portano le scelte della finestra al motore. -->
    <ProjectReference Include="..\WebcamLR.Effetti\WebcamLR.Effetti.csproj" />
  </ItemGroup>

</Project>
